# Keep the Fly build context lean. The image only needs dist/bundle.nq.gz +
# dist/solr-docs.json + deploy/fly/start.sh (see deploy/fly/Dockerfile).
.git
node_modules
third_party/skos/*/cache
third_party/skos/*/canonical.nq.gz
third_party/skos/*/normalized.nq.gz
docs
_site
*.log
# precomputed similarity is staged for the /api/similar-static + KG-graph wiring
# (cutover); not consumed by the image yet, and large — keep it out of the build.
deploy/fly/www/embeddings/similar
deploy/fly/www/embeddings/similar.nq.gz
# The float16 vectors (~4-7 GB across the corpus) would blow Fly's 8 GB image
# limit, so they are NOT baked — start.sh syncs them onto the mounted volume at
# boot (from the repo's public LFS), same as the e5 model. The small layouts/
# metas/index ARE baked, so galaxies render with no download. See start.sh.
deploy/fly/www/embeddings/*.emb.f16
