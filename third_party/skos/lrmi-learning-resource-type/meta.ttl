# LRMI (Learning Resource Metadata Initiative) concept scheme "learningResourceType", curated by
# the DCMI LRMI Task Group. SKOS values for educational-resource metadata.
# License: CC BY 4.0 (DCMI) -> open. Source: RDF/Turtle from dublincore.org.
<#scheme> a skosdex:Scheme ;
    dcterms:title "LRMI learningResourceType (DCMI Learning Resource Metadata Initiative)" ;
    dcterms:publisher <https://www.dublincore.org/> ;
    skosdex:conceptSchemeURI <http://purl.org/dcx/lrmi-vocabs/learningResourceType/> ;
    skosdex:sourceURL <https://www.dublincore.org/vocabs/learningResourceType.ttl> ;
    skosdex:sourceFormat "text/turtle" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle true .
