		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/spsocpenalty/serious-infraction-play"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/spsocpenalty/violent-conduct"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/spsocpenalty/spitting"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/spsocpenalty/offensive-language"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/spsocpenalty/offensive-gestures"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/spsocpenalty/professional-infraction"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/spsocpenalty/unsporting-behaviour"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/spsocpenalty/delaying-restart"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/spsocpenalty/illegal-reentry"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/spsocpenalty/illegal-entry"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/spsocpenalty/required-distance-foul"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/spsocpenalty/illegal-exit"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/spsocpenalty/hand-ball"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/spsocpenalty/tackle"/>
