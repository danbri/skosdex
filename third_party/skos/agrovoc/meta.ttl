@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# AGROVOC (FAO). CC BY 4.0 -> open, bundleable. The LOD dump is a ~95MB zip of
# N-Triples that expands to ~1.45GB; skosdex:compression "zip" unzips it in the
# fetch step. Big: canonical.nq.gz is committed via Git LFS.
<#scheme> a skosdex:Scheme ;
    dcterms:title "AGROVOC" ;
    dcterms:publisher <https://www.fao.org/> ;
    skosdex:conceptSchemeURI <http://aims.fao.org/aos/agrovoc> ;
    skosdex:sourceURL <https://agrovoc.fao.org/latestAgrovoc/agrovoc_lod.nt.zip> ;
    skosdex:sourceFormat "application/n-triples" ;
    skosdex:compression "zip" ;
    skosdex:sourceEntry "agrovoc_lod.nt" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle true .
