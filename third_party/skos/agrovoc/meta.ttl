@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# AGROVOC (FAO). CC BY 4.0 -> open, so it MAY be bundled, but the full LOD dump
# is very large and ships zipped, so bundle:false by default.
# CAVEAT: the dump is a .zip of N-Triples/N-Quads. The default pipeline does not
# unzip, so onboarding for real needs a tools/ helper (unzip -> .nt) or a
# pre-unzipped sourceFile. Confirm the exact dump URL at onboarding time; the
# landing page below lists the current release files.
<#scheme> a skosdex:Scheme ;
    dcterms:title "AGROVOC" ;
    dcterms:publisher <https://www.fao.org/> ;
    skosdex:conceptSchemeURI <http://aims.fao.org/aos/agrovoc> ;
    skosdex:sourceURL <https://agrovoc.fao.org/latestAgrovoc/agrovoc_lod.nt.zip> ;  # zipped N-Triples; needs an unzip helper
    skosdex:sourceFormat "application/n-triples" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle false .
