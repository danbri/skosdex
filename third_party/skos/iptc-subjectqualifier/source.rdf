	<rdf:Description rdf:about="http://cv.iptc.org/newscodes/subjectqualifier/00000001">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">female</skos:prefLabel>
		<skos:definition xml:lang="en-GB">A generic qualifier that pertains to the female sex </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/subjectqualifier/"/>
		<ikos:created>2008-01-01T01:00:00+00:00</ikos:created>
		<ikos:modified>2010-12-15T22:14:42+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/subjectqualifier/00000002">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">male</skos:prefLabel>
		<skos:definition xml:lang="en-GB">A generic qualifier that pertains to the male sex </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/subjectqualifier/"/>
		<ikos:created>2008-01-01T01:00:00+00:00</ikos:created>
		<ikos:modified>2010-12-15T22:14:42+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/subjectqualifier/12000001">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">church (organisation)</skos:prefLabel>
		<skos:definition xml:lang="en-GB">In Christian doctrine, the Christian religious community as a whole, or a body or organisation of Christian believers. </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/subjectqualifier/"/>
		<ikos:created>2008-01-01T01:00:00+00:00</ikos:created>
		<ikos:modified>2010-12-15T22:14:42+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/subjectqualifier/12000002">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">religious facility</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Any facility where a group can carry out its religious rites whether it is a mosque, a church, a house or a tent </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/subjectqualifier/"/>
		<ikos:created>2008-01-01T01:00:00+00:00</ikos:created>
