		<skos:prefLabel xml:lang="en-GB">deaf</skos:prefLabel>
		<skos:definition xml:lang="en-GB">NA </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/subjectqualifier/"/>
		<ikos:created>2008-01-01T01:00:00+00:00</ikos:created>
		<ikos:modified>2010-12-15T22:14:42+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/subjectqualifier/15000032">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">opening ceremony</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Public ceremony marking the start of a series of sporting competitions </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/subjectqualifier/"/>
		<ikos:created>2008-01-01T01:00:00+00:00</ikos:created>
		<ikos:modified>2010-12-15T22:14:42+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/subjectqualifier/15000033">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">closing ceremony</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Public ceremony marking the conclusion of a series of sporting competitions </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/subjectqualifier/"/>
		<ikos:created>2008-01-01T01:00:00+00:00</ikos:created>
		<ikos:modified>2010-12-15T22:14:42+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/subjectqualifier/15000034">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">major</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Professional, top-ranking within the sport </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/subjectqualifier/"/>
		<ikos:created>2008-01-01T01:00:00+00:00</ikos:created>
		<ikos:modified>2010-12-15T22:14:42+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/subjectqualifier/15000035">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">minor</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Professional, but lower ranking within the sport </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/subjectqualifier/"/>
		<ikos:created>2008-01-01T01:00:00+00:00</ikos:created>
		<ikos:modified>2010-12-15T22:14:42+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/subjectqualifier/15000036">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">semi-professional</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Part time paid athletes or players. </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/subjectqualifier/"/>
		<ikos:created>2008-01-01T01:00:00+00:00</ikos:created>
		<ikos:modified>2010-12-15T22:14:42+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/subjectqualifier/15000037">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">game/match/contest</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Specific match or contest between individuals or teams </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/subjectqualifier/"/>
		<ikos:created>2008-01-01T01:00:00+00:00</ikos:created>
		<ikos:modified>2010-12-15T22:14:42+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/subjectqualifier/15000038">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">league</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Governing body of a group of teams or individual players </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/subjectqualifier/"/>
		<ikos:created>2008-01-01T01:00:00+00:00</ikos:created>
		<ikos:modified>2010-12-15T22:14:42+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/subjectqualifier/15000039">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">event in progress</skos:prefLabel>
		<skos:definition xml:lang="en-GB">To indicate that the data contained in the body relates to an unfinished event, such as half-time scores, league standings at a specific time etc. </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/subjectqualifier/"/>
		<ikos:created>2008-01-01T01:00:00+00:00</ikos:created>
		<ikos:modified>2010-12-15T22:14:42+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/subjectqualifier/15000040">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">event final</skos:prefLabel>
		<skos:definition xml:lang="en-GB">To indicate that the data contained in the body relates to an event that has been concluded and that this data is, for example, the final score, or the winning team/player of a championship. </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/subjectqualifier/"/>
		<ikos:created>2008-01-01T01:00:00+00:00</ikos:created>
		<ikos:modified>2010-12-15T22:14:42+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/subjectqualifier/15000041">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">injury</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Injury to a sports person that could cause them to be sidelined, and the resulting effect on their team/sport. </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/subjectqualifier/"/>
		<ikos:created>2008-01-01T01:00:00+00:00</ikos:created>
		<ikos:modified>2010-12-15T22:14:42+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/subjectqualifier/15000042">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">business</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Including contractual negotiations and agreements between sporting persons, teams, labour organisations and businesses related to sports.. </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/subjectqualifier/"/>
		<ikos:created>2008-01-01T01:00:00+00:00</ikos:created>
		<ikos:modified>2010-12-15T22:14:42+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/subjectqualifier/15000043">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">sports facilities</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Gymnasiums, stadiums or arenas where sports events take place </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/subjectqualifier/"/>
		<ikos:created>2008-01-01T01:00:00+00:00</ikos:created>
		<ikos:modified>2010-12-15T22:14:42+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/subjectqualifier/15000044">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">record</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The best performance in a specific sport or discipline thereof of an individual or a team compared with earlier performances either of the same individual or team or with earlier performances of other individuals or teams. </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/subjectqualifier/"/>
		<ikos:created>2008-01-01T01:00:00+00:00</ikos:created>
		<ikos:modified>2010-12-15T22:14:42+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/subjectqualifier/15000045">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">selection</skos:prefLabel>
		<skos:definition xml:lang="en-GB">A list of competitors, or players chosen for a team for a specific game or event </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/subjectqualifier/"/>
		<ikos:created>2008-01-01T01:00:00+00:00</ikos:created>
		<ikos:modified>2010-12-15T22:14:42+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/subjectqualifier/15000046">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">coaches/trainers/managers</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The responsible official for a team's or individual's performance. To include changes of the official contract extensions etc. </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/subjectqualifier/"/>
		<ikos:created>2008-01-01T01:00:00+00:00</ikos:created>
		<ikos:modified>2010-12-15T22:14:42+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/subjectqualifier/15000047">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">umpires/referees</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Officials, including linesmen, stewards, marshals etc, responsible for the fair and orderly conduct of a sporting event. </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/subjectqualifier/"/>
		<ikos:created>2008-01-01T01:00:00+00:00</ikos:created>
		<ikos:modified>2010-12-15T22:14:42+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description></rdf:RDF>