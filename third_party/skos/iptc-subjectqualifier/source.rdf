		<skos:prefLabel xml:lang="en-GB">Subject Qualifier</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Indicates a narrower attribute-like context for a Subject Code,  e.g. for sports: the gender of participants, indoor/outdoor competition etc.</skos:definition>
		<skos:note xml:lang="en-GB">This vocabulary should be used with the Subject Codes</skos:note>
