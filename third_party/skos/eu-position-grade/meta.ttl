@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# EU eProcurement / eForms codelist "position-grade" — EU Publications Office (EU
# Vocabularies). Reuse under Commission Decision 2011/833/EU, implemented as
# CC BY 4.0 -> open. Source: SKOS-core RDF/XML via the OP euvoc-download-handler;
# converted via rapper. Part of the complete eProcurement authority-table set.
<#scheme> a skosdex:Scheme ;
    dcterms:title "position-grade — EU eProcurement codelist (Publications Office)" ;
    dcterms:publisher <https://op.europa.eu/> ;
    skosdex:conceptSchemeURI <http://publications.europa.eu/resource/authority/position-grade> ;
    skosdex:sourceURL <https://op.europa.eu/o/opportal-service/euvoc-download-handler?cellarURI=http://publications.europa.eu/resource/distribution/position-grade/20210929-0/rdf/skos_core/position-grade-skos.rdf&fileName=position-grade-skos.rdf> ;
    skosdex:sourceFormat "application/rdf+xml" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle true .
