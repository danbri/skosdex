@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# MARC Countries (LC) — Library of Congress (id.loc.gov). US Government work, no
# domestic copyright -> public-domain, bundleable. SKOS .skosrdf.nt.gz (gzip).
<#scheme> a skosdex:Scheme ;
    dcterms:title "MARC Countries (LC)" ;
    dcterms:publisher <https://www.loc.gov/> ;
    skosdex:conceptSchemeURI <http://id.loc.gov/vocabulary/countries> ;
    skosdex:sourceURL <https://id.loc.gov/download/vocabulary/countries.skosrdf.nt.gz> ;
    skosdex:sourceFormat "application/n-triples" ;
    skosdex:compression "gzip" ;
    dcterms:license <https://www.loc.gov/legal/> ;
    skosdex:licenseClass "public-domain" ;
    skosdex:bundle true .
