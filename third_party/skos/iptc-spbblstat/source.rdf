		<skos:definition xml:lang="en-GB">TBD.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/saves-tough">
