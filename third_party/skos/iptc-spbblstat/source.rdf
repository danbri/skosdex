		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">batters-triples-against</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">batters-triples-against</skos:prefLabel>
		<skos:definition xml:lang="en-GB">TBD.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/batters-home-runs-against">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">batters-home-runs-against</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">batters-home-runs-against</skos:prefLabel>
		<skos:definition xml:lang="en-GB">TBD.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/inherited-runners-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">inherited-runners-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">inherited-runners-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">TBD.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/sacrifice-flies-allowed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">sacrifice-flies-allowed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">sacrifice-flies-allowed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">TBD.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/shutouts-combined">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">shutouts-combined</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">shutouts-combined</skos:prefLabel>
		<skos:definition xml:lang="en-GB">TBD.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/double-plays">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">double-plays</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">double-plays</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of times two runners thrown out at the base.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/triple-plays">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">triple-plays</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">triple-plays</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of times three runners thrown out at the base.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/putouts">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">putouts</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">putouts</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of times a fielder caught a fly ball for an out.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/assists">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">assists</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">assists</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of plays in which a fielder throws a ball to another fielder for the
                out.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/errors">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">errors</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">errors</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of plays in which a fielder committed an error, such as dropping a
                ball.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/fielding-chances">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fielding-chances</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fielding-chances</skos:prefLabel>
		<skos:definition xml:lang="en-GB">TBD.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/fielding-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fielding-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fielding-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">A measure of fielding success. Calculated as follows: (putouts + assists) /
                (putouts + assists + errors).</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/defensive-average">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">defensive-average</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">defensive-average</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Rate a fielder turns a bill hit to their area into an out.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/errors-passed-ball">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">errors-passed-ball</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">errors-passed-ball</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of times a catcher is faulted with letting a pitched ball go
                past.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/errors-catchers-interference">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">errors-catchers-interference</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">errors-catchers-interference</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of times a catcher has improperly interfered with play.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/stolen-bases-against">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">stolen-bases-against</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">stolen-bases-against</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of bases successfully stolen while this player was on the
                field.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/stolen-bases-caught-defense">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">stolen-bases-caught-defense</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">stolen-bases-caught-defense</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of times a runner was caught while trying to steal bases while this
                player was on the field.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/stolen-bases-average-defense">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">stolen-bases-average-defense</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">stolen-bases-average-defense</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Success rate for stealing bases while this player was on the
                field.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/innings-played">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">innings-played</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">innings-played</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of innings played at the named position.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/games-played-position">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">games-played-position</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">games-played-position</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of games played at the named position.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description></rdf:RDF>