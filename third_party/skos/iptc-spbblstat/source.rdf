	<rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/average">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">average</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">average</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of hits per at-bats</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/runs-scored">
