		<skos:prefLabel xml:lang="en-GB">stolen-bases-average</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Success rate for stealing bases.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/hit-by-pitch">
