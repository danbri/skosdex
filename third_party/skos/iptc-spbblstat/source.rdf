		<skos:definition xml:lang="en-GB">TBD.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/relief-points">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">relief-points</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">relief-points</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Formula for rating relief performances. 4 points for a tough save; 3 points
                for a save; 2 for a relief win; minus 2 for a relief loss and blown
                save.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/shutouts">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">shutouts</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">shutouts</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of games pitched in which opposing team did not score</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/games-complete">
