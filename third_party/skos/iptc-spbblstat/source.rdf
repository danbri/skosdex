		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">batters-on-base-percentage-against</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">batters-on-base-percentage-against</skos:prefLabel>
		<skos:definition xml:lang="en-GB">TBD.</skos:definition>
