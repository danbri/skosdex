		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">winning-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">winning-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Calculated by wins divided by (wins + losses).</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/event-credit">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">event-credit</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">event-credit</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Whether a pitcher has received credit for winning or losing the game. TBD.
                Controlled Vocabulary.
                (win|loss|save|blown-save|win-blown-save|loss-blown-save|hold-win|hold-loss)</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/save-credit">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">save-credit</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">save-credit</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Whether a pitcher has received credit for winning or losing the game. TBD.
                Controlled Vocabulary.
                (win|loss|save|blown-save|win-blown-save|loss-blown-save|hold-win|hold-loss)</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/batters-average-against">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">batters-average-against</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">batters-average-against</skos:prefLabel>
		<skos:definition xml:lang="en-GB">TBD.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/batters-at-bats-against">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">batters-at-bats-against</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">batters-at-bats-against</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of batters faced who were credited with at-bats.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/batters-total-against">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">batters-total-against</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">batters-total-against</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of batters faced.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/batters-total-bases-against">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">batters-total-bases-against</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">batters-total-bases-against</skos:prefLabel>
		<skos:definition xml:lang="en-GB">TBD.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/batters-slugging-percentage-against">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">batters-slugging-percentage-against</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">batters-slugging-percentage-against</skos:prefLabel>
		<skos:definition xml:lang="en-GB">TBD.</skos:definition>
