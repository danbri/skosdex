		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/on-base-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">on-base-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">on-base-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Calculated as follows: (hits + bases-on-balls + hit-by-pitch) / (at-bats +
                bases-on-balls + hit-by-pitch + sac-flies)</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/stolen-bases">
