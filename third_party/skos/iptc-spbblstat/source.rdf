		<skos:prefLabel xml:lang="en-GB">on-base-plus-slugging</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Calculated by adding on-base-percentage to slugging-percentage.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/plate-appearances">
