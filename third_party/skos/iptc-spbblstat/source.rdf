		<skos:prefLabel xml:lang="en-GB">sac-bunts</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of bunts resulting in batter out which advance base
                runner(s)</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/sacrifices">
