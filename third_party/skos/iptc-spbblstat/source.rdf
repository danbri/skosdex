                bases.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/stolen-bases-average">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
