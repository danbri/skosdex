		<skos:prefLabel xml:lang="en-GB">stolen-bases</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of successfully stolen bases.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbblstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbblstat/stolen-bases-caught">
