		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/sptenstat/return-games-won-pct"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/sptenstat/break-points-played"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/sptenstat/break-points-converted"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/sptenstat/break-points-converted-pct"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/sptenstat/net-points-won"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/sptenstat/net-points-played"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/sptenstat/net-points-won-pct"/>
