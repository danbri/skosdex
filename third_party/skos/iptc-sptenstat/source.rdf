		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/sptenstat/second-serve-average-speed"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/sptenstat/speed-units"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/sptenstat/returns-played"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/sptenstat/receive-points-won"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/sptenstat/receive-points-won-pct"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/sptenstat/first-service-return-points-won"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/sptenstat/first-service-return-points-won-pct"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/sptenstat/second-service-return-points-won"/>
