@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# Library of Congress Subject Headings. Public domain (US Government work).
# The bulk dump is ~101MB gzipped N-Triples; skosdex:compression "gzip" handles
# decompression. Big: canonical.nq.gz committed via Git LFS.
<#scheme> a skosdex:Scheme ;
    dcterms:title "Library of Congress Subject Headings (LCSH)" ;
    dcterms:publisher <https://id.loc.gov/> ;
    skosdex:conceptSchemeURI <http://id.loc.gov/authorities/subjects> ;
    skosdex:sourceURL <https://id.loc.gov/download/authorities/subjects.skosrdf.nt.gz> ;
    skosdex:sourceFormat "application/n-triples" ;
    skosdex:compression "gzip" ;
    dcterms:license <https://www.loc.gov/legal/> ;
    skosdex:licenseClass "public-domain" ;
    skosdex:bundle true .
