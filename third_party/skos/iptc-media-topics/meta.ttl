@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# IPTC Media Topics (NewsCodes). CC BY 4.0 -> open, so it MAY be bundled.
# Left bundle:false for now (opt in deliberately). The CV server supports
# content negotiation: requesting text/turtle returns SKOS Turtle directly,
# so no tools/ helper or unzip is needed — flip bundle to true and run
# `skosdex build iptc-media-topics` to fetch and include it.
<#scheme> a skosdex:Scheme ;
    dcterms:title "IPTC Media Topics" ;
    dcterms:publisher <https://iptc.org/> ;
    skosdex:conceptSchemeURI <http://cv.iptc.org/newscodes/mediatopic/> ;
    skosdex:sourceURL <https://cv.iptc.org/newscodes/mediatopic/> ;  # serves text/turtle via content negotiation
    skosdex:sourceFormat "text/turtle" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle false .
