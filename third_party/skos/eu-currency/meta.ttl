@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# Currencies Named Authority List ("currency" authority table, ISO 4217) from
# the EU Publications Office (EU Vocabularies). Reuse is governed by Commission
# Decision 2011/833/EU, which the EU legal notice implements as CC BY 4.0
# (verified 2026-06-11 via the data.europa.eu dataset record "currency") -> open.
#
# Source: the SKOS_CORE distribution (currencies-skos.rdf, RDF/XML) via the OP
# euvoc-download-handler, resolved from the dataset's data.europa.eu
# distribution list. The pipeline converts RDF/XML via rapper. ~292 concepts.
<#scheme> a skosdex:Scheme ;
    dcterms:title "Currencies Named Authority List (EU Publications Office, ISO 4217)" ;
    dcterms:publisher <https://op.europa.eu/> ;
    skosdex:conceptSchemeURI <http://publications.europa.eu/resource/authority/currency> ;
    skosdex:sourceURL <https://op.europa.eu/o/opportal-service/euvoc-download-handler?cellarURI=http%3A%2F%2Fpublications.europa.eu%2Fresource%2Fcellar%2F32bd2d70-2b56-11e7-9412-01aa75ed71a1.0001.09%2FDOC_1&fileName=currencies-skos.rdf> ;
    skosdex:sourceFormat "application/rdf+xml" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle true .
