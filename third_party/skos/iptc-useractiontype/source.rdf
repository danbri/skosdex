         xmlns:skos="http://www.w3.org/2004/02/skos/core#">
   <rdf:Description rdf:about="http://cv.iptc.org/newscodes/useractiontype/">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
      <ikos:prefSchemeAlias>useracttype</ikos:prefSchemeAlias>
      <ikos:authority>http://www.iptc.org</ikos:authority>
      <dct:rightsHolder>IPTC, International Press Telecommunications Council - https://iptc.org</dct:rightsHolder>
      <ikos:licenceLink>http://creativecommons.org/licenses/by/4.0/</ikos:licenceLink>
      <ikos:dateReleased>2024-02-13T12:00:00+00:00</ikos:dateReleased>
      <skos:prefLabel xml:lang="en-GB">User Action Type NewsCodes</skos:prefLabel>
      <skos:definition xml:lang="en-GB">Indicates the type of user action.</skos:definition>
      <skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/useractiontype/comment"/>
      <skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/useractiontype/fblike"/>
      <skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/useractiontype/googleplus"/>
      <skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/useractiontype/like"/>
      <skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/useractiontype/pageviews"/>
      <skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/useractiontype/retweets"/>
      <skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/useractiontype/share"/>
      <skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/useractiontype/tweets"/>
   </rdf:Description>
   <rdf:Description rdf:about="http://cv.iptc.org/newscodes/useractiontype/comment">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:prefLabel xml:lang="en-GB">Comment</skos:prefLabel>
      <skos:definition xml:lang="en-GB">Replying to an item with an opinion, statement or question</skos:definition>
      <skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/useractiontype/"/>
      <ikos:created>2024-02-13T12:00:00+00:00</ikos:created>
      <ikos:modified>2024-02-13T12:00:00+00:00</ikos:modified>
      <!--Broader Relationships-->
      <!--Narrower Relationships-->
      <!--SKOS Mapping Relationships-->
   </rdf:Description>
   <rdf:Description rdf:about="http://cv.iptc.org/newscodes/useractiontype/fblike">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:prefLabel xml:lang="en-GB">Facebook Likes</skos:prefLabel>
      <skos:definition xml:lang="en-GB">Indicates that the user interaction was measured by Facebook likes.</skos:definition>
      <skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/useractiontype/"/>
      <ikos:created>2013-02-14T12:00:00+00:00</ikos:created>
      <ikos:retired>2024-02-13T12:00:00+00:00</ikos:retired>
      <ikos:modified>2013-02-14T12:00:00+00:00</ikos:modified>
      <!--Broader Relationships-->
      <!--Narrower Relationships-->
      <!--SKOS Mapping Relationships-->
   </rdf:Description>
   <rdf:Description rdf:about="http://cv.iptc.org/newscodes/useractiontype/googleplus">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:prefLabel xml:lang="en-GB">Google's +1</skos:prefLabel>
      <skos:definition xml:lang="en-GB">Indicates that the user interaction was measured by Google's +1 feature.</skos:definition>
      <skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/useractiontype/"/>
      <ikos:created>2013-02-14T12:00:00+00:00</ikos:created>
      <ikos:retired>2023-09-12T12:00:00+00:00</ikos:retired>
      <ikos:modified>2013-02-14T12:00:00+00:00</ikos:modified>
      <!--Broader Relationships-->
      <!--Narrower Relationships-->
      <!--SKOS Mapping Relationships-->
   </rdf:Description>
   <rdf:Description rdf:about="http://cv.iptc.org/newscodes/useractiontype/like">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:prefLabel xml:lang="en-GB">Like</skos:prefLabel>
      <skos:definition xml:lang="en-GB">The action of showing approval for an item, usually in the form of a heart or thumbs up emoji</skos:definition>
      <skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/useractiontype/"/>
      <ikos:created>2024-02-13T12:00:00+00:00</ikos:created>
      <ikos:modified>2024-02-13T12:00:00+00:00</ikos:modified>
      <!--Broader Relationships-->
      <!--Narrower Relationships-->
      <!--SKOS Mapping Relationships-->
   </rdf:Description>
   <rdf:Description rdf:about="http://cv.iptc.org/newscodes/useractiontype/pageviews">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:prefLabel xml:lang="en-GB">Views</skos:prefLabel>
      <skos:definition xml:lang="en-GB">Reading or viewing an item</skos:definition>
      <skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/useractiontype/"/>
      <ikos:created>2013-02-14T12:00:00+00:00</ikos:created>
      <ikos:modified>2024-02-13T12:00:00+00:00</ikos:modified>
      <!--Broader Relationships-->
      <!--Narrower Relationships-->
      <!--SKOS Mapping Relationships-->
   </rdf:Description>
   <rdf:Description rdf:about="http://cv.iptc.org/newscodes/useractiontype/retweets">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:prefLabel xml:lang="en-GB">Twitter re-tweets</skos:prefLabel>
      <skos:definition xml:lang="en-GB">Indicates that the user interaction was measured by re-tweets of a tweet on Twitter, also known as X.</skos:definition>
      <skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/useractiontype/"/>
      <ikos:created>2013-02-14T12:00:00+00:00</ikos:created>
      <ikos:retired>2024-02-13T12:00:00+00:00</ikos:retired>
      <ikos:modified>2013-02-14T12:00:00+00:00</ikos:modified>
      <!--Broader Relationships-->
      <!--Narrower Relationships-->
      <!--SKOS Mapping Relationships-->
   </rdf:Description>
   <rdf:Description rdf:about="http://cv.iptc.org/newscodes/useractiontype/share">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:prefLabel xml:lang="en-GB">Share</skos:prefLabel>
      <skos:definition xml:lang="en-GB">Sharing an item with followers by quoting or reposting it</skos:definition>
      <skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/useractiontype/"/>
      <ikos:created>2024-02-13T12:00:00+00:00</ikos:created>
      <ikos:modified>2024-02-13T12:00:00+00:00</ikos:modified>
      <!--Broader Relationships-->
      <!--Narrower Relationships-->
      <!--SKOS Mapping Relationships-->
   </rdf:Description>
   <rdf:Description rdf:about="http://cv.iptc.org/newscodes/useractiontype/tweets">
      <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
      <skos:prefLabel xml:lang="en-GB">Twitter tweets</skos:prefLabel>
      <skos:definition xml:lang="en-GB">Indicates that the user interaction was measured by posts on Twitter (also known as X) which mention the subject of the content.</skos:definition>
      <skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/useractiontype/"/>
      <ikos:created>2013-02-14T12:00:00+00:00</ikos:created>
      <ikos:retired>2024-02-13T12:00:00+00:00</ikos:retired>
      <ikos:modified>2023-09-12T12:00:00+00:00</ikos:modified>
      <!--Broader Relationships-->
      <!--Narrower Relationships-->
      <!--SKOS Mapping Relationships-->
   </rdf:Description>
