@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# Tesauro de Materias (Patrimonio Cultural de Espana)
# License verified 2026-08-21: Bespoke open terms: "uso libre y gratuito, incluido el comercial ... en cualquiera de sus formas de explotacion (reproduccion, distribucion, comunicacion publica y transformacion)"; attribution + URL mention required.
<#scheme> a skosdex:Scheme ;
    dcterms:title "Tesauro de Materias (Patrimonio Cultural de Espana)" ;
    dcterms:publisher <https://www.cultura.gob.es/> ;
    skosdex:conceptSchemeURI <https://tesauros.cultura.gob.es/tesauros/materias> ;
    skosdex:sourceURL <https://tesauros.cultura.gob.es/tesauros/descarga/skos-materias.zip> ;
    skosdex:sourceFormat "application/rdf+xml" ;
    skosdex:compression "zip" ;
    skosdex:sourceEntry "skos-materias.rdf" ;
    dcterms:license <https://tesauros.cultura.gob.es/tesauros/condiciones-de-uso> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle true .
