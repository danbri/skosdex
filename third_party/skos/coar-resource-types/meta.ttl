@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# COAR Resource Types (v3.2)
# License verified 2026-08-21: CC0 per repo LICENSE (full CC0 text) + site footer; GitHub master is stale v1.1 - use the website .nt files.
<#scheme> a skosdex:Scheme ;
    dcterms:title "COAR Resource Types (v3.2)" ;
    dcterms:publisher <https://coar-repositories.org/> ;
    skosdex:conceptSchemeURI <http://purl.org/coar/resource_type/> ;
    skosdex:sourceURL <https://vocabularies.coar-repositories.org/resource_types/resource_types.nt> ;
    skosdex:sourceFormat "application/n-triples" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    skosdex:licenseClass "public-domain" ;
    skosdex:bundle true .
