# European List of Waste (LoW 2015) — Eurostat / EU Publications Office. The
# European Waste Catalogue: ~842 waste types as 6-digit EWC codes with
# hazardous flags (Commission Decision 2014/955/EU). Published as SKOS-AP-EU.
# Reuse under Commission Decision 2011/833/EU, implemented as CC BY 4.0
# (verified 2026-06-11) -> open. ~974 concepts in the distribution.
#
# Source: ESTAT-LoW2015-skos-ap-eu.rdf (RDF/XML) via the OP
# euvoc-download-handler. Converted via rapper.
<#scheme> a skosdex:Scheme ;
    dcterms:title "European List of Waste (LoW 2015) — Eurostat / EU Publications Office" ;
    dcterms:publisher <https://op.europa.eu/> ;
    skosdex:conceptSchemeURI <http://data.europa.eu/6p8/low2015/scheme> ;
    skosdex:sourceURL <https://op.europa.eu/o/opportal-service/euvoc-download-handler?cellarURI=http%3A%2F%2Fpublications.europa.eu%2Fresource%2Fcellar%2Fea409f39-71a5-11ee-9220-01aa75ed71a1.0001.01%2FDOC_1&fileName=ESTAT-LoW2015-skos-ap-eu.rdf> ;
    skosdex:sourceFormat "application/rdf+xml" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle true .
