@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# GACS — Global Agricultural Concept Scheme (FAO, CABI, USDA NAL working group).
# ~15,400 concepts merging AGROVOC, CAB Thesaurus and NALT; SKOS + SKOS-XL +
# ISO 25964 skos-thes. License: CC BY 4.0 (per agrisemantics.org/GACShome and the
# gacs/gacs-scheme repo LICENSE.txt; note the data file itself carries no embedded
# license triple). -> open. Source: AgroPortal direct download (RDF/Turtle, ~108MB
# raw). Project archived 2025 but sources live; data from 2017.
<#scheme> a skosdex:Scheme ;
    dcterms:title "GACS — Global Agricultural Concept Scheme (FAO/CABI/NAL)" ;
    dcterms:publisher <https://agrisemantics.org/> ;
    skosdex:conceptSchemeURI <http://id.agrisemantics.org/gacs-core> ;
    skosdex:sourceURL <https://agroportal.eu/ontologies/GACS/download> ;
    skosdex:sourceFormat "text/turtle" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle true .
