@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# NACE Rev. 2 — Statistical Classification of Economic Activities in the
# European Community, published as SKOS by the EU Publications Office
# (EU Vocabularies, dataset "nace2"). Reuse is governed by Commission Decision
# 2011/833/EU (the data.europa.eu record lists licence COM_REUSE, i.e. that
# Decision), which the EU legal notice implements as CC BY 4.0 (verified
# 2026-06-10 at https://commission.europa.eu/legal-notice_en; dataset record:
# https://data.europa.eu/data/datasets/nace2) -> open.
#
# Source: the SKOS_CORE distribution (ESTAT-NACE2.rdf, RDF/XML) via the OP
# euvoc-download-handler, as published in the dataset's download_url.
# The pipeline converts RDF/XML via rapper.
<#scheme> a skosdex:Scheme ;
    dcterms:title "NACE Rev. 2 — Statistical Classification of Economic Activities in the EC" ;
    dcterms:publisher <https://op.europa.eu/> ;
    skosdex:conceptSchemeURI <http://data.europa.eu/ux2/nace2/nace2> ;
    skosdex:sourceURL <https://op.europa.eu/o/opportal-service/euvoc-download-handler?cellarURI=http%3A%2F%2Fpublications.europa.eu%2Fresource%2Fcellar%2F29793eb7-0760-11ed-acce-01aa75ed71a1.0001.02%2FDOC_1&fileName=ESTAT-NACE2.rdf> ;
    skosdex:sourceFormat "application/rdf+xml" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle true .
