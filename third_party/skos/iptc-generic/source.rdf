		<ikos:dateReleased>2018-01-25T14:05:58+00:00</ikos:dateReleased>
		<skos:prefLabel xml:lang="en-GB">Generic Concepts</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Generic concepts which could be applied to virtually all properties</skos:definition>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/generic/null"/>
	</rdf:Description>
	<rdf:Description rdf:about="http://cv.iptc.org/newscodes/generic/null">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">null</skos:prefLabel>
		<skos:definition xml:lang="en-GB">This concept does not represent anything</skos:definition>
		<skos:note xml:lang="en-GB">This pseudo-concept should be used to explicitly state that a null value applies to a property. E.g. this is required when partMeta properties nullify assertions from a higher level.
</skos:note>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/generic/"/>
