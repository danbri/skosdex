@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# EU Publications Office authority table "procedure" (EU Vocabularies). Reuse under
# Commission Decision 2011/833/EU, implemented as CC BY 4.0 -> open.
<#scheme> a skosdex:Scheme ;
    dcterms:title "procedure — EU authority table (Publications Office)" ;
    dcterms:publisher <https://op.europa.eu/> ;
    skosdex:conceptSchemeURI <http://publications.europa.eu/resource/authority/procedure> ;
    skosdex:sourceURL <https://op.europa.eu/o/opportal-service/euvoc-download-handler?cellarURI=http://publications.europa.eu/resource/distribution/procedure/20230614-0/rdf/skos_core/legislativeprocedures-skos.rdf&fileName=legislativeprocedures-skos.rdf> ;
    skosdex:sourceFormat "application/rdf+xml" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle true .
