<rdf:RDF xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:ikos="http://cv.iptc.org/newscodes/ikos/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:dct="http://purl.org/dc/terms/">
	<rdf:Description rdf:about="http://cv.iptc.org/newscodes/hopactiontarget/">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
		<ikos:prefSchemeAlias>hatarget</ikos:prefSchemeAlias>
		<ikos:authority>http://www.iptc.org</ikos:authority>
		<dct:rightsHolder>IPTC, International Press Telecommunications Council - https://iptc.org</dct:rightsHolder>
		<ikos:licenceLink>http://creativecommons.org/licenses/by/4.0/</ikos:licenceLink>
		<ikos:dateReleased>2018-01-25T14:06:00+00:00</ikos:dateReleased>
		<skos:prefLabel xml:lang="en-GB">Hop Action Target</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Indicates the target to which an action taken at a hop of the hop history applies.</skos:definition>
		<skos:note xml:lang="en-GB">This vocabulary applies only to NewsML-G2 items.</skos:note>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/hopactiontarget/content"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/hopactiontarget/metadata"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/hopactiontarget/object"/>
	</rdf:Description>
	<rdf:Description rdf:about="http://cv.iptc.org/newscodes/hopactiontarget/content">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">content</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The content of the object, could be present in different renditions.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/hopactiontarget/"/>
		<ikos:created>2011-11-04T12:00:00+00:00</ikos:created>
		<ikos:modified>2011-11-04T12:00:00+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/hopactiontarget/metadata">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">metadata</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Any metadata associated with the content of the object
</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/hopactiontarget/"/>
		<ikos:created>2011-11-04T12:00:00+00:00</ikos:created>
		<ikos:modified>2011-11-04T12:00:00+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/hopactiontarget/object">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">object</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The union of metadata and content</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/hopactiontarget/"/>
