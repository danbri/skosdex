@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# Getty Art & Architecture Thesaurus (AAT). ODC-By 1.0 -> open, bundleable.
# full.zip (~252MB) holds three N-Triples members; AATOut_Full.nt is the
# complete graph (~3.64GB). skosdex:compression "zip" + sourceEntry select it.
# Big: canonical.nq.gz committed via Git LFS.
<#scheme> a skosdex:Scheme ;
    dcterms:title "Getty Art & Architecture Thesaurus (AAT)" ;
    dcterms:publisher <https://www.getty.edu/research/> ;
    skosdex:conceptSchemeURI <http://vocab.getty.edu/aat/> ;
    skosdex:sourceURL <http://aatdownloads.getty.edu/VocabData/full.zip> ;
    skosdex:sourceFormat "application/n-triples" ;
    skosdex:compression "zip" ;
    skosdex:sourceEntry "AATOut_Full.nt" ;
    dcterms:license <https://opendatacommons.org/licenses/by/1-0/> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle true .
