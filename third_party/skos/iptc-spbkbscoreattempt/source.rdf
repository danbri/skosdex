		<skos:prefLabel xml:lang="en-GB">fg3</skos:prefLabel>
		<skos:definition xml:lang="en-GB">A three-pointer.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbscoreattempt/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description></rdf:RDF>