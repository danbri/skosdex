	<rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbscoreattempt/free-throw">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">free-throw</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">free-throw</skos:prefLabel>
		<skos:definition xml:lang="en-GB">A foul shot, worth one point.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbscoreattempt/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbscoreattempt/fg">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fg</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fg</skos:prefLabel>
		<skos:definition xml:lang="en-GB">A two-point field goal.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbscoreattempt/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbscoreattempt/fg3">
