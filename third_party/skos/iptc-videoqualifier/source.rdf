		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/videoqualifier/"/>
		<ikos:created>2016-10-14T14:00:00+00:00</ikos:created>
		<ikos:modified>2018-01-19T13:00:00+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/videoqualifier/streamReady">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">Stream ready</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Indicates if this video can be used for streaming by the rule of having the key technical data of the video at the start rather than end of the file and that the wrapper and essense format are suitable for streaming</skos:definition>
		<skos:note xml:lang="en-GB">Use with Video Metadata Hub property: Stream Ready</skos:note>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/videoqualifier/"/>
		<ikos:created>2016-10-14T14:00:00+00:00</ikos:created>
		<ikos:modified>2018-01-19T13:00:00+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/videoqualifier/stylePeriod">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">Style period</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The style, historical or artistic period, movement, group, or school whose characteristics are represented by the movie</skos:definition>
		<skos:note xml:lang="en-GB">Use with Video Metadata Hub property: Style Period</skos:note>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/videoqualifier/"/>
