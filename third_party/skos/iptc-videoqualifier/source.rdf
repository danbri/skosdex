		<ikos:modified>2018-01-19T13:00:00+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/videoqualifier/signalFormat">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">Signal format</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Combined term including the size of the frame, interlaced/progressive, framerate </skos:definition>
