		<ikos:modified>2018-01-19T13:00:00+00:00</ikos:modified><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/videoqualifier/storylineId">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-GB">Storyline identifier</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Identifier of a story evolving over time and this media resource is assocated with</skos:definition>
