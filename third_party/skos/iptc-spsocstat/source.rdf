		<skos:definition xml:lang="en-GB">The number of total tackles won by the player</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spsocstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spsocstat/tackles-won-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">tackles-won-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">tackles-won-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Percentage of successful tackles.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spsocstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spsocstat/tackles-lost">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">tackles-lost</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">tackles-lost</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of total tackles lost by the player</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spsocstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spsocstat/shots-blocked-outfielder">
