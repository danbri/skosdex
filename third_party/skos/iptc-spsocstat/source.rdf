		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spsocstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spsocstat/tackles-won">
