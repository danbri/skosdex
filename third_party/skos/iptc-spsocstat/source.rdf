		<skos:prefLabel xml:lang="en-GB">passes-complete-long</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of successful long passes.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spsocstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spsocstat/aerials-won">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
