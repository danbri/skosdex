		<skos:prefLabel xml:lang="en-GB">aerials-won</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Gained possession after an aerial duel.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spsocstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spsocstat/crosses-18-yard">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">crosses-18-yard-plus</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">crosses-18-yard-plus</skos:prefLabel>
		<skos:definition xml:lang="en-GB">A cross pass less than 18 yards from the byline which was caught by the
				goalkeeper.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spsocstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spsocstat/crosses-18-yard-plus">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">crosses-18-yard-plus</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">crosses-18-yard-plus</skos:prefLabel>
		<skos:definition xml:lang="en-GB">A cross pass more than 18 yards from the byline which was caught by the
				goalkeeper.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spsocstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spsocstat/tackles-total">
