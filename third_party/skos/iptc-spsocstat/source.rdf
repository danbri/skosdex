		<skos:prefLabel xml:lang="en-GB">shots-blocked-outfielder</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of shots blocked by a defender.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spsocstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spsocstat/shots-blocked-cross">
