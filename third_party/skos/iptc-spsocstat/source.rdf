		<skos:definition xml:lang="en-GB">The number of cross passes blocked.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spsocstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spsocstat/clearances">
