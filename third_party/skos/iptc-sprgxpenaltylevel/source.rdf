	<rdf:Description rdf:about="http://cv.iptc.org/newscodes/sprgxpenaltylevel/yellow-card">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">yellow-card</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">yellow-card</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Penalty shown by a yellow card - also known as a caution.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/sprgxpenaltylevel/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/sprgxpenaltylevel/red-card">
