		<skos:prefLabel xml:lang="en-US">red-card</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">red-card</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Penalty shown as a red card - also known as an ejection.</skos:definition>
