		<skos:prefLabel xml:lang="en-GB">free-throws-made</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Shots made that were worth one point each.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/free-throws-attempted">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">free-throws-attempted</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">free-throws-attempted</skos:prefLabel>
		<skos:definition xml:lang="en-GB">One-point shots that were attempted.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/free-throws-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">free-throws-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">free-throws-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Free throws made versus attempted.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/free-throws-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">free-throws-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">free-throws-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of free throws made per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/free-throws-attempted-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">free-throws-attempted-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">free-throws-attempted-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of free throws attempted per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/points-scored-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">points-scored-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">points-scored-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of points scored, over.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/points-scored-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">points-scored-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">points-scored-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of points scored in games played.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/points-scored-per-game-highest">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">points-scored-per-game-highest</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">points-scored-per-game-highest</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Highest number of points scored in one game played.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/points-scored-per-shot">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">points-scored-per-shot</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">points-scored-per-shot</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Calculated by dividing points-scored-total by
                field-goals-attempted.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/assists-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">assists-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">assists-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of assists.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/assists-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">assists-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">assists-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of assists per games played.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/turnovers-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">turnovers-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">turnovers-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of turnovers.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/turnovers-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">turnovers-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">turnovers-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of turnovers per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/team-turnovers-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">team-turnovers-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">team-turnovers-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of team turnovers.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/team-turnovers-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">team-turnovers-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">team-turnovers-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of team turnovers per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/points-scored-off-turnovers">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">points-scored-off-turnovers</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">points-scored-off-turnovers</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of points scored off turnovers.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/points-scored-in-paint">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">points-scored-in-paint</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">points-scored-in-paint</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of points scored from within the painted area surrounding the
                basket.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/points-scored-on-second-chance">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">points-scored-on-second-chance</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">points-scored-on-second-chance</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of points scored after fielding an offensive
                rebound.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/points-scored-on-fast-break">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">points-scored-on-fast-break</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">points-scored-on-fast-break</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of points scored off a fast break.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/rebounds-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rebounds-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rebounds-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The sum of all rebounds that were credited to particular
                players.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/rebounds-total-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rebounds-total-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rebounds-total-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The percentage of rebounds total compared to total number of
                attempts.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/rebounds-defensive">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rebounds-defensive</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rebounds-defensive</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The sum of all defensive rebounds credited to particular players. A
                defensive rebound occurs when the team is in defence but gains possession through a
                rebound.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/rebounds-opponent-defensive">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rebounds-opponent-defensive</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rebounds-opponent-defensive</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The total defensive rebounds by the opposing team or player.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/rebounds-defensive-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rebounds-defensive-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rebounds-defensive-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The percentage of defensive rebounds.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/rebounds-offensive">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rebounds-offensive</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rebounds-offensive</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The sum of all offensive rebounds credited to particular player. An
                offensive rebound is when the team keep possession of the ball through a
                rebound.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/rebounds-offensive-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rebounds-offensive-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rebounds-offensive-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The percentage of offensive rebounds.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/rebounds-opponent-offensive">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rebounds-opponent-offensive</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rebounds-opponent-offensive</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The total offensive rebounds by the opposing team or player.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/team-rebounds-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">team-rebounds-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">team-rebounds-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of rebounds that did not credited to individual players, but were
                instead credited to the team as a whole.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/team-rebounds-total-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">team-rebounds-total-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">team-rebounds-total-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Percentage of team rebounds.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/team-rebounds-defensive">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">team-rebounds-defensive</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">team-rebounds-defensive</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The sum of all defensive rebounds credited to the team as a
                whole.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/team-rebounds-defensive-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">team-rebounds-defensive-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">team-rebounds-defensive-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The percentage of defensive rebounds credited to the team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/team-rebounds-offensive">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">team-rebounds-offensive</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">team-rebounds-offensive</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The sum of all offensive rebounds credited to the team as a
                whol.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/team-rebounds-offensive-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">team-rebounds-offensive-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">team-rebounds-offensive-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The percentage of offensive rebounds credited to the team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/team-rebounds-opponent-defensive">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">team-rebounds-opponent-defensive</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">team-rebounds-opponent-defensive</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The total defensive team rebounds by the opposing team or
                player.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/team-rebounds-opponent-offensive">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">team-rebounds-opponent-offensive</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">team-rebounds-opponent-offensive</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The total offensive team rebounds by the opposing team or
                player.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/rebounds-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rebounds-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rebounds-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The average number of personal rebounds per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/team-rebounds-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">team-rebounds-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">team-rebounds-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The average number of team rebounds per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/rebounds-offensive-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rebounds-offensive-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rebounds-offensive-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The average number of offensive personal rebounds per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/rebounds-defensive-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rebounds-defensive-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rebounds-defensive-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The average numer of defensive personal rebounds per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/rebounds-differential">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rebounds-differential</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rebounds-differential</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The differential between the total number of rebounds from this team
                compared to the opposing team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/rebounds-opponent-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rebounds-opponent-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rebounds-opponent-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The total number of rebounds (ofensive and defensive) by the opposing team
                or player.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/team-rebounds-opponent-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">team-rebounds-opponent-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">team-rebounds-opponent-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The total number of rebounds (ofensive and defensive) by the opponent which
                are credited to the team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/steals-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">steals-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">steals-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of steals.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/steals-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">steals-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">steals-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of steals per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/steals-opponent">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">steals-opponent</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">steals-opponent</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of steals-against by opponent.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/steals-differential">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">steals-differential</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">steals-differential</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of steals made by this team compared to steals made by the other
                team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/blocks-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">blocks-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">blocks-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of blocks.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/blocks-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">blocks-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">blocks-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of blocks per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/blocks-opponent">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">blocks-opponent</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">blocks-opponent</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of blocks-against by opponent.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/blocks-differential">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">blocks-differential</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">blocks-differential</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of blocks made by this team compared to blocks made by the
                other team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/points-scored-against-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">points-scored-against-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">points-scored-against-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average of points scored against per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/points-scored-against-per-game-highest">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">points-scored-against-per-game-highest</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">points-scored-against-per-game-highest</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Highest number of points scored against in one game played.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/field-goals-against-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">field-goals-against-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">field-goals-against-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The average number of field goals scored agains per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/field-goals-against-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">field-goals-against-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">field-goals-against-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The percentage of field goals scored against.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/charges-taken">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">charges-taken</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">charges-taken</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of charges taken. A charge is when the referee toss the ball
                and one player of each team try to give their team possession of the
                ball.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description></rdf:RDF>