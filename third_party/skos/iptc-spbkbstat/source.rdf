	<rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/minutes-played">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">minutes-played</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">minutes-played</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of minutes this player has spent playing during a particular
                game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/games-played">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">games-played</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">games-played</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of games played.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/games-started">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">games-started</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">games-started</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of games that started with this player on the court,.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/average-minutes-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">average-minutes-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">average-minutes-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of minutes per game played by this player.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/personal-fouls-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">personal-fouls-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">personal-fouls-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of fouls made by the player per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/double-doubles">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">double-doubles</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">double-doubles</skos:prefLabel>
		<skos:definition xml:lang="en-GB">A double digit number in any two of these categories: points, rebounds,
                assists, steals, and blocked shots.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/triple-doubles">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">triple-doubles</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">triple-doubles</skos:prefLabel>
		<skos:definition xml:lang="en-GB">A double digit number in any three of these categories: points, rebounds,
                assists, steals, and blocked shots.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/timeouts-left">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">timeouts-left</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">timeouts-left</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of timeouts a team has left during the current event.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/largest-lead">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">largest-lead</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">largest-lead</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Largest number of points this team has led the opposition. Could be a
                negative number.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/fouls-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fouls-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fouls-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of fouls comitted by the team during this event.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/turnover-margin">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">turnover-margin</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">turnover-margin</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Turnover margain is the number of turnovers made by this team minus the
                number of turnovers made by the opposing team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/field-goals-made">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">field-goals-made</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">field-goals-made</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Shots made that were worth two points each.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/field-goals-attempted">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">field-goals-attempted</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">field-goals-attempted</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Two-point shots that were attempted.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/field-goals-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">field-goals-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">field-goals-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Field goals made versus attempted. This could also be calculated from the
                above.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/field-goals-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">field-goals-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">field-goals-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of field goals made per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/field-goals-attempted-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">field-goals-attempted-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">field-goals-attempted-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of field goals attempted per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/field-goals-percentage-adjusted">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">field-goals-percentage-adjusted</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">field-goals-percentage-adjusted</skos:prefLabel>
		<skos:definition xml:lang="en-GB">A formula measuring shooting efficiency: [(points-scored-total -
                free-throws-made)/field-goals-attempted]/2.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/three-pointers-made">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">three-pointers-made</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">three-pointers-made</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Shots made that were worth three points each.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/three-pointers-attempted">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">three-pointers-attempted</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">three-pointers-attempted</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Three-point shots that were attempted.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/three-pointers-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">three-pointers-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">three-pointers-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Three-pointers made versus attempted. This could be calculated.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/three-pointers-per-game">
