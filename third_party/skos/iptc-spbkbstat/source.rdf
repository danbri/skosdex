		<skos:prefLabel xml:lang="en-GB">three-pointers-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of three-pointers made per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spbkbstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spbkbstat/three-pointers-attempted-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
