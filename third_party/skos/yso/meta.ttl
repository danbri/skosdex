@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# YSO — General Finnish Ontology (Yleinen suomalainen ontologia), trilingual
# fi/sv/en, maintained by the National Library of Finland and published on
# Finto. License CC BY 4.0 (verified 2026-06-10 on the Finto YSO page
# https://finto.fi/yso/en/ which links creativecommons.org/licenses/by/4.0/)
# -> open.
#
# Source: full Turtle dump via the Finto Skosmos REST API (same pattern as
# udc-summary's Finto source).
<#scheme> a skosdex:Scheme ;
    dcterms:title "YSO — General Finnish Ontology" ;
    dcterms:publisher <https://www.kansalliskirjasto.fi/> ;
    skosdex:conceptSchemeURI <http://www.yso.fi/onto/yso/> ;
    skosdex:sourceURL <https://api.finto.fi/rest/v1/yso/data?format=text%2Fturtle> ;
    skosdex:sourceFormat "text/turtle" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle true .
