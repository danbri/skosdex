@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# Humord <-> Realfagstermer mapping, published by the University of Oslo
# Library alongside both thesauri (same data.ub.uio.no/dumps/ pipeline; both
# parent datasets assert CC0 in-band — the mapping N-Triples file carries no
# license triples of its own, so it inherits the publisher's CC0 dedication
# covering the dumps). Verified 2026-08-21.
<#scheme> a skosdex:Scheme ;
    dcterms:title "Humord mapping: Realfagstermer" ;
    dcterms:publisher <https://www.ub.uio.no/> ;
    skosdex:conceptSchemeURI <http://data.ub.uio.no/humord/mapping/realfagstermer> ;
    skosdex:sourceURL <https://data.ub.uio.no/dumps/humord-realfagstermer.mappings.nt> ;
    skosdex:sourceFormat "application/n-triples" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    skosdex:licenseClass "public-domain" ;
    skosdex:bundle true .
