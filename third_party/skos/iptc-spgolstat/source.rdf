	<rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/rank">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rank</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rank</skos:prefLabel>
		<skos:definition xml:lang="en-GB">How this player ranks among the other competing players.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/handicap">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">handicap</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">handicap</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The handicap-value of this player. This will normally not be used in
                professional tournaments.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/rounds">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rounds</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rounds</skos:prefLabel>
		<skos:definition xml:lang="en-GB">How many rounds the player or team has completed in this particular
                tournament.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/average">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">average</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">average</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average score of the player or team. Number of shots devided by number of
                holes??</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/distance-longest">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">distance-longest</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">distance-longest</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The longest distance the player shot.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/distance-rank">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">distance-rank</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">distance-rank</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The rank in the round or tournament for the player when comparing the
                longest distance shot.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/drives">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">drives</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">drives</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of drives made by the player.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/total-rounds">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">total-rounds</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">total-rounds</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of rounds played during the current tournament.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/total-strokes">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">total-strokes</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">total-strokes</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of strokes (or swings) (or shots) made.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/total-holes">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">total-holes</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">total-holes</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of holes played.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/total-putts">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">total-putts</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">total-putts</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of putts attempted.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/total-points">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">total-points</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">total-points</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total score of the player. Depending on the system used in the tournament
                the score could be something other than the actual number of strokes.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/total-driving">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">total-driving</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">total-driving</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total driving distance.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/total-par-or-less">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">total-par-or-less</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">total-par-or-less</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of holes played by the player at par or less than
                par.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/birdies">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">birdies</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">birdies</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of birdies.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/birdies-rank">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">birdies-rank</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">birdies-rank</skos:prefLabel>
		<skos:definition xml:lang="en-GB">How the player ranks in the round or tournament regarding
                birdies.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/eagles">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">eagles</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">eagles</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of eagles.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/eagles-rank">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">eagles-rank</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">eagles-rank</skos:prefLabel>
		<skos:definition xml:lang="en-GB">How the player ranks in the round or tournament regarding
                eagles.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/saves">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">saves</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">saves</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of saves when the ball landed in a sand bunker.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/saves-rank">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">saves-rank</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">saves-rank</skos:prefLabel>
		<skos:definition xml:lang="en-GB">How the player ranks in the round or tournament regarding saves from the
                bunker.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/bunkers">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">bunkers</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">bunkers</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of bunker shots the player took.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/eagle-per-holes-frequency">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">eagle-per-holes-frequency</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">eagle-per-holes-frequency</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Frequency of hitting eagles.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/greens-hit">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">greens-hit</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">greens-hit</skos:prefLabel>
		<skos:definition xml:lang="en-GB">This is a very special golf term. To reach a green in regulation (GIR) the
                player must place the ball on the green with two strokes less than the par of the
                course. The attribute holds the number of times the player or team has achieved this
                in the timeframe the stats cover.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/greens-hit-rank">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">greens-hit-rank</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">greens-hit-rank</skos:prefLabel>
		<skos:definition xml:lang="en-GB">How the player ranks in the tournament or round regarding greens hit in
                regulation.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/greens-in-regulation-missed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">greens-in-regulation-missed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">greens-in-regulation-missed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of greens missed during regulation play.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spgolstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spgolstat/greens-in-regulation-putting">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">greens-in-regulation-putting</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">greens-in-regulation-putting</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The average number of puts needed to finish holes after hitting the green in
                regulation (GIR).</skos:definition>
