# https://data.europa.eu/data/datasets/nuts~~1) -> open.
#
# Source: the SKOS_CORE distribution (NUTS.rdf, RDF/XML) via the OP
# euvoc-download-handler, as published in the dataset's download_url.
# The pipeline converts RDF/XML via rapper.
<#scheme> a skosdex:Scheme ;
    dcterms:title "NUTS — Nomenclature of Territorial Units for Statistics (EU)" ;
    dcterms:publisher <https://op.europa.eu/> ;
    skosdex:conceptSchemeURI <http://data.europa.eu/nuts> ;
    skosdex:sourceURL <https://op.europa.eu/o/opportal-service/euvoc-download-handler?cellarURI=http%3A%2F%2Fpublications.europa.eu%2Fresource%2Fcellar%2F1feb4c1e-3937-11ea-ba6e-01aa75ed71a1.0001.05%2FDOC_1&fileName=NUTS.rdf> ;
    skosdex:sourceFormat "application/rdf+xml" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle true .
