@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# AgroPortal SKOS ontology "WCACROPS". Fetched key-free via the AgroPortal download
# endpoint (enumerated through the public ontologies_filter?format=SKOS, found
# by headless-browser discovery). License see source -> open if CC BY/CC0.
<#scheme> a skosdex:Scheme ;
    dcterms:title "WCACROPS (AgroPortal)" ;
    dcterms:publisher <https://agroportal.eu/> ;
    skosdex:conceptSchemeURI <http://stats-class.fao.uniroma2.it/WCA_CropList/> ;
    skosdex:sourceURL <https://agroportal.eu/ontologies/WCACROPS/download> ;
    skosdex:sourceFormat "application/n-triples" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle true .
