@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# Library of Congress Genre/Form Terms for Library and Archival Materials
# (LCGFT). Public domain (US Government work, same terms as LCSH; see
# https://www.loc.gov/legal/). Bulk SKOS N-Triples dump is ~750KB gzipped;
# skosdex:compression "gzip" handles decompression.
<#scheme> a skosdex:Scheme ;
    dcterms:title "Library of Congress Genre/Form Terms (LCGFT)" ;
    dcterms:publisher <https://id.loc.gov/> ;
    skosdex:conceptSchemeURI <http://id.loc.gov/authorities/genreForms> ;
    skosdex:sourceURL <https://id.loc.gov/download/authorities/genreForms.skosrdf.nt.gz> ;
    skosdex:sourceFormat "application/n-triples" ;
    skosdex:compression "gzip" ;
    dcterms:license <https://www.loc.gov/legal/> ;
    skosdex:licenseClass "public-domain" ;
    skosdex:bundle true .
