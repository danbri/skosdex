@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# Nomisma.org — collaboratively maintained thesaurus of numismatic concepts
# (mints, denominations, rulers, hoards...), SKOS plus nmo/CIDOC-CRM. The
# nomisma.org site footer links CC BY 3.0 ("This work is licensed under a
# Creative Commons Attribution 3.0 Unported License",
# https://creativecommons.org/licenses/by/3.0/, verified 2026-06-10 at
# https://nomisma.org/) -> open.
#
# Source: the full Turtle dump published at nomisma.org (~38MB).
#
# ONBOARDED 2026-06-12 (bundle:true): the upstream dump is MALFORMED Turtle —
# 60 prefixed names carry unescaped parentheses in the local part (e.g.
# `nm:italy_kingdom_(oadacer)`, `nm:a(-)oros_colophon`, `nm:taler_(jefimok)`),
# illegal per the Turtle grammar, so n3 and rapper both reject the file.
# Parentheses ARE legal inside a full IRIREF and `nm:` expands to
# <http://nomisma.org/id/>, so tools/nomisma-sanitise.mjs rewrites only those
# offending prefixed names to equivalent full IRIs — identical entities, valid
# syntax (a formatting fix, no semantic change). Rebuild from scratch:
#   skosdex fetch nomisma
#   node tools/nomisma-sanitise.mjs third_party/skos/nomisma/cache/source.ttl
#   skosdex normalize nomisma && skosdex canonicalize nomisma
# ~755k quads / 24k skos:Concept.
<#scheme> a skosdex:Scheme ;
    dcterms:title "Nomisma.org numismatic concepts" ;
    dcterms:publisher <https://nomisma.org/> ;
    skosdex:conceptSchemeURI <http://nomisma.org/> ;
    skosdex:sourceURL <https://nomisma.org/nomisma.org.ttl> ;
    skosdex:sourceFormat "text/turtle" ;
    dcterms:license <https://creativecommons.org/licenses/by/3.0/> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle true .
