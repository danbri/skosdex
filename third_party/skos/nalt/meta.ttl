@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# NAL Agricultural Thesaurus (NALT), USDA. CC0 1.0 -> public-domain, fully
# bundleable. The Skosmos REST dump returns a .zip of Turtle; skosdex:compression
# "zip" makes the fetch step unzip it automatically (~44MB Turtle inside).
# Big: 76,696 bilingual concepts / 1.15M quads / 142MB canonical, so its .nq is
# gitignored (regenerate with `skosdex build nalt`). bundle:true opts it into a
# locally-built bundle; it is NOT part of the committed/CI offline bundle.
<#scheme> a skosdex:Scheme ;
    dcterms:title "NAL Agricultural Thesaurus (NALT)" ;
    dcterms:publisher <https://www.nal.usda.gov/> ;
    skosdex:conceptSchemeURI <https://lod.nal.usda.gov/nalt/> ;
    skosdex:sourceURL <https://lod.nal.usda.gov/rest/v1/nalt/data?format=text/turtle> ;  # zipped Turtle
    skosdex:sourceFormat "text/turtle" ;
    skosdex:compression "zip" ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    skosdex:licenseClass "public-domain" ;
    skosdex:bundle true .
