@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# UDC Summary — Universal Decimal Classification, ~2,600 classes in 48
# languages, published as SKOS by the UDC Consortium (udcdata.info) under
# CC BY-SA 3.0 -> copyleft -> CONTAINER-ONLY under policy v2 (2026-06-10):
# bundled into the SPARQL/Solr container with explicit licensing and no
# semantic changes (N-Quads formatting only); never in static artifacts.
# (The full UDC scheme is proprietary and stays out entirely.)
<#scheme> a skosdex:Scheme ;
    dcterms:title "UDC Summary (Universal Decimal Classification)" ;
    dcterms:publisher <https://udcc.org/> ;
    skosdex:conceptSchemeURI <http://udcdata.info/udc-schema> ;
    skosdex:sourceURL <https://api.finto.fi/rest/v1/udcs/data?format=text%2Fturtle> ;  # udcdata.info zip is gone; Finto (NLF Skosmos) republishes
    skosdex:sourceFormat "text/turtle" ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/3.0/> ;
    skosdex:licenseClass "copyleft" ;
    skosdex:bundle true .
