@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# EU Publications Office authority table "procjur" (EU Vocabularies). Reuse under
# Commission Decision 2011/833/EU, implemented as CC BY 4.0 -> open.
<#scheme> a skosdex:Scheme ;
    dcterms:title "procjur — EU authority table (Publications Office)" ;
    dcterms:publisher <https://op.europa.eu/> ;
    skosdex:conceptSchemeURI <http://publications.europa.eu/resource/authority/procjur> ;
    skosdex:sourceURL <https://op.europa.eu/o/opportal-service/euvoc-download-handler?cellarURI=http://publications.europa.eu/resource/distribution/procjur/20231213-0/rdf/skos_core/procjur-skos.rdf&fileName=procjur-skos.rdf> ;
    skosdex:sourceFormat "application/rdf+xml" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle true .
