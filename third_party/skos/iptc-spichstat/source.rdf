	<rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/minutes-played">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">minutes-played</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">minutes-played</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of minutes player was on ice.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/plus-minus">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">plus-minus</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">plus-minus</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of times team/player was on ice when own team scored minus the number
                of times team/player was on ice when opponent scored.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/plus-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">plus-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">plus-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of team/times player was on ice when own team scored.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/minus-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">minus-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">minus-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of times tteam/player was on ice when opponent scored.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/penalty-minutes">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">penalty-minutes</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">penalty-minutes</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of penalty minutes accrued by a single player or
                team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/goals-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">goals-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">goals-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of goals by the team. Could differ from the score if
                score-points are awarded for shootout, for example.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/goals-game-winning">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">goals-game-winning</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">goals-game-winning</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Goals that provided the winning margin in a game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/goals-game-tying">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">goals-game-tying</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">goals-game-tying</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Goals that caused the game to be tied.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/goals-power-play">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">goals-power-play</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">goals-power-play</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Goals scored while the team was having a power-play.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/goals-short-handed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">goals-short-handed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">goals-short-handed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Goals scored while the team was playing short-handed.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/goals-even-strength">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">goals-even-strength</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">goals-even-strength</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Goals scored while the teams were at even strength.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/goals-empty-net">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">goals-empty-net</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">goals-empty-net</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Goals scored on an empty goal, with the opposing goalie pulled from the
                net.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/goals-overtime">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">goals-overtime</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">goals-overtime</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Goals scored during overtime.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/goals-shootout">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">goals-shootout</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">goals-shootout</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Goals scored during a shootout.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/goals-shootout-attempts">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">goals-shootout-attempts</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">goals-shootout-attempts</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Goals attempted during a shootout.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/goals-penalty-shot">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">goals-penalty-shot</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">goals-penalty-shot</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Goals scored as penalty shots.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/goals-per-game">
