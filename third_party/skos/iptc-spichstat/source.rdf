		<skos:prefLabel xml:lang="en-GB">goals-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average of goals scored per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/assists">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
