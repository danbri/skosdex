		<skos:prefLabel xml:lang="en-GB">assists</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of assists.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/assists-power-play">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">assists-power-play</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">assists-power-play</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of assists made during a power play.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/assists-short-handed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">assists-short-handed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">assists-short-handed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of assists made while short-handed.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/assists-game-winning">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">assists-game-winning</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">assists-game-winning</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Assists on goals that provided the winning margin in a game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/assists-game-tying">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">assists-game-tying</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">assists-game-tying</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Assists on goals that caused the game to be tied.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/assists-overtime">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">assists-overtime</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">assists-overtime</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Assists on goals scored during overtime.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/points">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">points</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">points</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of points, with a score and an assist generally counted as one
                point each.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/points-power-play">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">points-power-play</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">points-power-play</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of points during power plays, with a score and an assist
                generally counted as one point each.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/points-short-handed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">points-short-handed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">points-short-handed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of points while short-handed, with a score and an assist
                generally counted as one point each.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/power-play-amount">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">power-play-amount</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">power-play-amount</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of power-play opportunities a team has had.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/power-play-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">power-play-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">power-play-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Measure of success at power plays. Figured by dividing goals-power-play by
                power-play-amount.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/shots-penalty-shot-taken">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">shots-penalty-shot-taken</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">shots-penalty-shot-taken</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of penalty shots taken by a shooting player.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/shots-penalty-shot-missed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">shots-penalty-shot-missed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">shots-penalty-shot-missed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of penalty shots missed by a shooting player.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/shots-penalty-shot-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">shots-penalty-shot-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">shots-penalty-shot-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Percentage of penalty shots that resulted in goals.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/giveaways">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">giveaways</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">giveaways</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of times that passes were attempted but intercepted. A judgment call
                whose exact conditions vary.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/minutes-power-play">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">minutes-power-play</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">minutes-power-play</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of minutes played in a power-play.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/scoring-chances">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">scoring-chances</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">scoring-chances</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of qualified chances to score.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/hat-tricks">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">hat-tricks</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">hat-tricks</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of hat-trick games.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/shots-missed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">shots-missed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">shots-missed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of shots missed.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/shot-attempts-blocked">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">shot-attempts-blocked</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">shot-attempts-blocked</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of shots taken which were blocked by an opponent. </skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/shots-even-strength">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">shots-even-strength</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">shots-even-strength</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of shots taken at even strength.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/shots-power-play">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">shots-power-play</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">shots-power-play</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of shots taken on power play.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/shots-short-handed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">shots-short-handed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">shots-short-handed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of shots taken while short-handed.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/shots-power-play-allowed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">shots-power-play-allowed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">shots-power-play-allowed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of shots on goal allowed during power-play.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/shots-penalty-shot-allowed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">shots-penalty-shot-allowed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">shots-penalty-shot-allowed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of shots allowed as penalty-shots.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/goals-power-play-allowed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">goals-power-play-allowed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">goals-power-play-allowed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of goals allowed while the opposing team has a
                power-play.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/goals-penalty-shot-allowed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">goals-penalty-shot-allowed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">goals-penalty-shot-allowed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of goals allowed as penalty-shots.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/goals-empty-net-allowed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">goals-empty-net-allowed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">goals-empty-net-allowed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of goals allowed while the net was empty.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/goals-short-handed-allowed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">goals-short-handed-allowed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">goals-short-handed-allowed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of goals allowed while playing short-handed.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/goals-against-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">goals-against-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">goals-against-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of goals against for the given period. Could differ from the
                score if score-points are deducted for some reason.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/goals-against-average">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">goals-against-average</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">goals-against-average</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of goals per game allowed by the team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/saves">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">saves</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">saves</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of saves.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/save-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">save-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">save-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Percentage of saves compared to total number of shots.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/goals-shootout-allowed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">goals-shootout-allowed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">goals-shootout-allowed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of shootout goals that went in for a score for the opposing
                team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/shots-shootout-allowed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">shots-shootout-allowed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">shots-shootout-allowed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of shootout shots that were attempted by the opposing
                team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/penalty-killing-amount">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">penalty-killing-amount</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">penalty-killing-amount</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of penalty-killing sessions, aka number of short-handed
                sessions.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/penalty-killing-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">penalty-killing-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">penalty-killing-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Equals goals-penalty-allowed divided by penalty-killing-amount.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/shots-blocked">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">shots-blocked</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">shots-blocked</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of shots that were blocked. This statistic is generally tracked for
                non-goalies.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/takeaways">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">takeaways</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">takeaways</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of intercepted passes. A judgment call whose exact conditions
                vary.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/shutouts">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">shutouts</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">shutouts</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of games where the opposing team did not score.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/minutes-penalty-killing">
