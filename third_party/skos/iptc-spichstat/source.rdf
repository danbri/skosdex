		<skos:prefLabel xml:lang="en-GB">goaltender-wins</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of games with this goaltender.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/goaltender-losses">
