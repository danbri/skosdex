		<skos:prefLabel xml:lang="en-US">minutes-penalty-killing</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">minutes-penalty-killing</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of minutes played short-handed, while the other team had a
                power-play.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/hits">
