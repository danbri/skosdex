		<skos:prefLabel xml:lang="en-GB">hits</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of body checks made against an opposing player.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spichstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spichstat/goaltender-wins">
