	<rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/yards-per-attempt">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">yards-per-attempt</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">yards-per-attempt</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The average yards gained per play.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/number-of-plays">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">number-of-plays</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">number-of-plays</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of plays this team has completed, including for offensive,
                defensive, and special teams.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/number-of-plays-gaining">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">number-of-plays-gaining</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">number-of-plays-gaining</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of plays this team has completed for which yards were gained,
                including for offensive, defensive, and special teams.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/number-of-plays-losing">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">number-of-plays-losing</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">number-of-plays-losing</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of plays this team has completed for which yards were lost,
                including for offensive, defensive, and special teams.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/average-starting-position">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">average-starting-position</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">average-starting-position</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average yard-line that the team started on per-drive.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/timeouts">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">timeouts</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">timeouts</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of timeouts a team has remaining, either in regulation or in
                overtime, whichever state the game is currently in.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/turnover-ratio">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">turnover-ratio</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">turnover-ratio</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Derived by subtracting turnovers-giveaways from
                turnovers-takeaways.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/offensive-plays-yards">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">offensive-plays-yards</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">offensive-plays-yards</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The total yards accumulated through offensive plays.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/offensive-plays-number">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">offensive-plays-number</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">offensive-plays-number</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of offensive plays.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/offensive-plays-average-yards-per">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">offensive-plays-average-yards-per</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">offensive-plays-average-yards-per</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The average number of yards gained per play.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/offensive-plays-average-yards-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">offensive-plays-average-yards-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">offensive-plays-average-yards-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The average number of yards gained via offensive plays per
                game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/offensive-rank">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">offensive-rank</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">offensive-rank</skos:prefLabel>
		<skos:definition xml:lang="en-GB">How team's offense compares with rest of league or conference.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/possession-duration">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">possession-duration</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">possession-duration</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The average amount of time the team had possession per-drive.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/possessions-inside-20">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">possessions-inside-20</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">possessions-inside-20</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of times team has driven inside its opponent's 20 yard
                line.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/turnovers-giveaway">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">turnovers-giveaway</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">turnovers-giveaway</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Derived by adding passes-interceptions plus fumbles-own-lost.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/turnovers-giveaway-average">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">turnovers-giveaway-average</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">turnovers-giveaway-average</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average-per-game for turnovers-giveaway.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/handoffs-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">handoffs-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">handoffs-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Usually, number of times QB has handed off, typically leading to a running
                play.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/pitches-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">pitches-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">pitches-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Usually, number of times QB has pitched back to another player, typically
                leading to a running play.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/tackles-offense">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">tackles-offense</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">tackles-offense</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of tackles performed while on offense.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/tackles-assists-offense">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">tackles-assists-offense</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">tackles-assists-offense</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of tackle assists performed while on offense.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passes-attempts">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passes-attempts</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passes-attempts</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of passes attempted.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passes-completions">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passes-completions</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passes-completions</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of passes completed successfully.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passes-completions-average-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passes-completions-average-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passes-completions-average-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of completed passes a game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passes-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passes-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passes-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The percentage of all passes that are completed successfully.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passes-yards-gross">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passes-yards-gross</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passes-yards-gross</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of yards gained from passing.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passes-yards-net">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passes-yards-net</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passes-yards-net</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Subtracts out the sacks-against-yards-lost value of
                stats-american-football-sacks-against element.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passes-yards-lost">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passes-yards-lost</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passes-yards-lost</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Amount of yards lost due to sacks and completed passing plays that ended
                behind the line of scrimmage.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passes-yards-per-attempt">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passes-yards-per-attempt</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passes-yards-per-attempt</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Gross passing yards divided by number of pass attempts.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passes-first-down">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passes-first-down</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passes-first-down</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of passes a player or team has made for a first-down.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passes-touchdowns-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passes-touchdowns-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passes-touchdowns-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The ratio of touchdown passes to attempted passes.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passes-interceptions">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passes-interceptions</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passes-interceptions</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of passes that were intercepted.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passes-interceptions-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passes-interceptions-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passes-interceptions-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The ratio of intercepted passes to attempted passes.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passes-interceptions-yards">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passes-interceptions-yards</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passes-interceptions-yards</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Opponent's yards gained after interceptions.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passes-interceptions-average">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passes-interceptions-average</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passes-interceptions-average</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of interceptions per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passes-interceptions-longest">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passes-interceptions-longest</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passes-interceptions-longest</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Longest interception return against a passer.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passes-interceptions-touchdown">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passes-interceptions-touchdown</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passes-interceptions-touchdown</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of opponents' touchdowns scored from passer's
                interceptions.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passes-longest">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passes-longest</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passes-longest</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The yards gained by the single longest completion.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passes-average-yards-per">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passes-average-yards-per</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passes-average-yards-per</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Gross passing yards divided by number of pass completions.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passes-average-yards-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passes-average-yards-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passes-average-yards-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total yards passing divided by number of games played.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passer-rating">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passer-rating</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passer-rating</skos:prefLabel>
		<skos:definition xml:lang="en-GB">A complex formula designed to measure quarterback performance.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/receptions-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">receptions-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">receptions-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The total number of successful passes.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/receptions-average-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">receptions-average-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">receptions-average-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of receptions per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/receptions-yards">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">receptions-yards</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">receptions-yards</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of yards a receiver is credited for.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/receptions-first-down">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">receptions-first-down</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">receptions-first-down</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of receptions a player has taken for a first-down.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/receptions-longest">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">receptions-longest</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">receptions-longest</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The longest reception a player had, including to the point where they
                scored, were-tackled, etc.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/receptions-looks">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">receptions-looks</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">receptions-looks</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of opportunities this receiver had to receive the
                ball.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/receptions-average-yards">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">receptions-average-yards</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">receptions-average-yards</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average yards per game from receptions.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/receptions-average-yards-per">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">receptions-average-yards-per</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">receptions-average-yards-per</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The average yards per reception.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passing-rank">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passing-rank</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passing-rank</skos:prefLabel>
		<skos:definition xml:lang="en-GB">How a player or team's passing stats ranks in a league or conference,
                usually using total passing yards as the measure.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/times-thrown-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">times-thrown-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">times-thrown-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of passes directed at receiver, including incompletions,
                interceptions, etc.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/receptions-career-100-yard-games">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">receptions-career-100-yard-games</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">receptions-career-100-yard-games</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of times in receiver's career where total receiving yardage per game
                exceeded 100.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passing-career-300-yard-games">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passing-career-300-yard-games</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passing-career-300-yard-games</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of times in passer's career where total passing yardage per game
                exceeded 300.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/rushes-attempts">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rushes-attempts</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rushes-attempts</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of attempted rushes.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/rushes-yards">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rushes-yards</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rushes-yards</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of yards gained by rushing.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/rushes-yards-left">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rushes-yards-left</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rushes-yards-left</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of yards gained by rushing up the left side of the
                field.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/rushes-yards-middle">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rushes-yards-middle</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rushes-yards-middle</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of yards gained by rushing up the middle of the
                field.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/rushes-yards-right">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rushes-yards-right</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rushes-yards-right</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of yards gained by rushing up the right side of the
                field.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/rushing-average-yards-per">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rushing-average-yards-per</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rushing-average-yards-per</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The average number of yards per rush.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/rushes-first-down">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rushes-first-down</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rushes-first-down</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of rushes that have resulted in a first-down.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/rushes-longest">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rushes-longest</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rushes-longest</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of yards gained by the single longest rushing play.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/rushes-average-attempts-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rushes-average-attempts-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rushes-average-attempts-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of rushing attempts per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/rushes-average-yards-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rushes-average-yards-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rushes-average-yards-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of yards gaining from rushes a game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/rushing-rank">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rushing-rank</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rushing-rank</skos:prefLabel>
		<skos:definition xml:lang="en-GB">How a player or team's rushing stats ranks in a league or conference,
                usually using total rushing yards as the measure.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/rushes-career-100-yard-games">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">rushes-career-100-yard-games</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">rushes-career-100-yard-games</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of times in rusher's career where total rushing yardage per game
                exceeded 100.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/first-downs-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">first-downs-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">first-downs-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of first downs achieved.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/first-downs-pass">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">first-downs-pass</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">first-downs-pass</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of first downs achieved from passing.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/first-downs-run">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">first-downs-run</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">first-downs-run</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of first downs achieved from rushing.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/first-downs-penalty">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">first-downs-penalty</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">first-downs-penalty</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of first downs achieved from penalties on the other
                team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/first-downs-yards">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">first-downs-yards</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">first-downs-yards</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of yards gained on first down plays.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/first-downs-average-yards-per">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">first-downs-average-yards-per</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">first-downs-average-yards-per</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of average yards gained on first down plays.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/conversions-second-down">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">conversions-second-down</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">conversions-second-down</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of first downs achieved on a second down.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/conversions-second-down-attempts">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">conversions-second-down-attempts</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">conversions-second-down-attempts</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of second downs.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/conversions-second-down-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">conversions-second-down-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">conversions-second-down-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The percentage of first down attempts on a second down that were
                successful.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/conversions-third-down">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">conversions-third-down</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">conversions-third-down</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of first downs achieved on a third down.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/conversions-third-down-attempts">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">conversions-third-down-attempts</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">conversions-third-down-attempts</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of third downs.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/conversions-third-down-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">conversions-third-down-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">conversions-third-down-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The percentage of first down attempts on a third down that were
                successful.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/conversions-fourth-down">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">conversions-fourth-down</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">conversions-fourth-down</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of first downs achieved on a fourth down.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/conversions-fourth-down-attempts">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">conversions-fourth-down-attempts</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">conversions-fourth-down-attempts</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fourth downs.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/conversions-fourth-down-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">conversions-fourth-down-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">conversions-fourth-down-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The percentage of first down attempts on a fourth down that were
                successful.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/sacks-against-yards">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">sacks-against-yards</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">sacks-against-yards</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of yards lost by the offense from sacks.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/sacks-against-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">sacks-against-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">sacks-against-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of times that the offense was sacked.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/sacks-against-average">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">sacks-against-average</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">sacks-against-average</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of times per game a quarterback is sacked.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/sacks-against-safeties">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">sacks-against-safeties</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">sacks-against-safeties</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of sacks that resulted in safeties.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/tackles-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">tackles-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">tackles-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of tackles made by the defense. Commonly the sum of tackles-solo
                and tackles-assists.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/tackles-solo">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">tackles-solo</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">tackles-solo</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of tackles made where only one member of the defense commited the
                tackle.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/tackles-assists">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">tackles-assists</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">tackles-assists</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of tackles made where multiple members of the defense commited
                the tackle.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/tackles-team">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">tackles-team</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">tackles-team</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of tackles made which were credited to the team as a
                whole.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/quarterback-hurries">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">quarterback-hurries</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">quarterback-hurries</skos:prefLabel>
		<skos:definition xml:lang="en-GB">An unofficial stat given when a defensive player pressures and hurries the
                quarterback into making a throw to avoid being sacked.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/passes-defensed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">passes-defensed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">passes-defensed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of times a pass was deflected or otherwise defended against,
                causing a pass to be incomplete.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/turnovers-takeaway">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">turnovers-takeaway</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">turnovers-takeaway</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Derived by adding interceptions-total plus
                fumbles-opposing-recovered.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/yards-allowed-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">yards-allowed-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">yards-allowed-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total yardage a defense allowed, usually through passing and
                rushing.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/yards-allowed-average">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">yards-allowed-average</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">yards-allowed-average</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total yardage a defense allows per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/defensive-plays-number">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">defensive-plays-number</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">defensive-plays-number</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of plays a defense is on the field.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/inside-20-plays">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">inside-20-plays</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">inside-20-plays</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of plays inside defensive team's 20 yard line.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/inside-20-points-against">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">inside-20-points-against</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">inside-20-points-against</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of points given up when opponents' possession starts inside defensive
                team's 20 yard line.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/inside-20-touchdowns-against">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">inside-20-touchdowns-against</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">inside-20-touchdowns-against</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of touchdowns given up when opponents' possession starts inside
                defensive team's 20 yard line.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/inside-20-touchdowns-against-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">inside-20-touchdowns-against-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">inside-20-touchdowns-against-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Ratio of touchdowns allowed to possessions when opponents' possession starts
                inside defensive team's 20 yard line.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/defense-rank">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">defense-rank</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">defense-rank</skos:prefLabel>
		<skos:definition xml:lang="en-GB">How a team's defensive stats rank in a league or conference, usually using
                yards allowed per game as the measure.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/defense-rank-pass">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">defense-rank-pass</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">defense-rank-pass</skos:prefLabel>
		<skos:definition xml:lang="en-GB">How a team's passing defense stats rank in a league or conference, usually
                using passing yards allowed per game as the measure.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/defense-rank-rush">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">defense-rank-rush</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">defense-rank-rush</skos:prefLabel>
		<skos:definition xml:lang="en-GB">How a team's rushing defense stats rank in a league or conference, usually
                using rushing yards allowed per game as the measure.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/interceptions-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">interceptions-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">interceptions-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of passes the defense has intercepted.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/interceptions-yards">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">interceptions-yards</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">interceptions-yards</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of yards gained as a result of an interception.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/interceptions-average">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">interceptions-average</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">interceptions-average</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The average number of yards gained from interceptions.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/interceptions-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">interceptions-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">interceptions-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Percentage of passes intercepted.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/interceptions-longest">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">interceptions-longest</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">interceptions-longest</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The longest interception returned. Greatest number of yards gained on an
                interception.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/interceptions-touchdown">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">interceptions-touchdown</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">interceptions-touchdown</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of interceptions that were run back for a touchdown.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/sacks-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">sacks-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">sacks-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of sacks made by the defense.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/sacks-yards">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">sacks-yards</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">sacks-yards</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of yards gained by the defense.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/sacks-team">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">sacks-team</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">sacks-team</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of sacks credited to the team as a whole.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/sacks-yards-team">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">sacks-yards-team</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">sacks-yards-team</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of yards gained by the defense on sacks credited to the team as a
                whole.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/touchdowns-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">touchdowns-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">touchdowns-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of touchdowns scored by the offense.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/touchdowns-passing">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">touchdowns-passing</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">touchdowns-passing</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of touchdowns scored by passing.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/touchdowns-rushing">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">touchdowns-rushing</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">touchdowns-rushing</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of touchdowns scored by rushing.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/touchdowns-special-teams">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">touchdowns-special-teams</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">touchdowns-special-teams</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of touchdowns scored by special teams.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/touchdowns-defensive">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">touchdowns-defensive</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">touchdowns-defensive</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of touchdowns scored by the defense.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/touchdowns-receptions">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">touchdowns-receptions</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">touchdowns-receptions</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of receptions resulting in a touchdown.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/extra-points-attempts">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">extra-points-attempts</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">extra-points-attempts</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of extra points attempted by the offense.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/extra-points-made">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">extra-points-made</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">extra-points-made</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of extra points made.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/extra-points-missed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">extra-points-missed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">extra-points-missed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of extra points missed.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/extra-points-blocked">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">extra-points-blocked</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">extra-points-blocked</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of extra point attempts that were blocked.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/extra-points-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">extra-points-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">extra-points-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Ratio of extra points completed to attempts.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/field-goal-attempts">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">field-goal-attempts</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">field-goal-attempts</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of field goals attempted.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/field-goals-made">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">field-goals-made</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">field-goals-made</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of field goals made.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/field-goals-missed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">field-goals-missed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">field-goals-missed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of field goals missed.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/field-goals-blocked">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">field-goals-blocked</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">field-goals-blocked</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of field goal attempts that were blocked.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/field-goal-longest">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">field-goal-longest</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">field-goal-longest</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Yardage of longest successful field goal attempt.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/field-goals-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">field-goals-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">field-goals-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Ratio of field goals made to attempts.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/field-goals-average">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">field-goals-average</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">field-goals-average</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of field goals made per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/safeties-against">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">safeties-against</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">safeties-against</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of safeties scored against the offense.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/two-point-conversions-attempts">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">two-point-conversions-attempts</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">two-point-conversions-attempts</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of two point conversions attempted.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/two-point-conversions-made">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">two-point-conversions-made</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">two-point-conversions-made</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of successful two point conversions.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/two-point-conversions-made-rushing">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">two-point-conversions-made-rushing</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">two-point-conversions-made-rushing</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of successful two-point conversions from running plays.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/two-point-conversions-made-passing">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">two-point-conversions-made-passing</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">two-point-conversions-made-passing</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of successful two-point conversions from passing plays.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/touchbacks">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">touchbacks</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">touchbacks</skos:prefLabel>
		<skos:definition xml:lang="en-GB">For Canadian Football. Used to record the number of touchbacks that resulted
                in scores.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/single-points">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">single-points</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">single-points</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of points earned from the single, a CFL-specific scoring play where a
                kicking team prevents its opponent from returning a kickoff, punt or missed field
                goal from outside the opponent's own end zone.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/inside-20-points">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">inside-20-points</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">inside-20-points</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Points earned by offensive team when possession starts inside opponent's 20
                yard line.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/inside-20-touchdowns">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">inside-20-touchdowns</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">inside-20-touchdowns</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Touchdowns scored by offensive team when possession starts inside opponent's
                20 yard line.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/inside-20-touchdowns-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">inside-20-touchdowns-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">inside-20-touchdowns-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Ratio of touchdowns to possessions when possession starts inside opponent's
                20 yard line.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-punt-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-punt-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-punt-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of punts returned.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-punt-yards">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-punt-yards</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-punt-yards</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of yards gained from punt returns.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-punt-average">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-punt-average</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-punt-average</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The average number of yards gained on each punt return.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-punt-longest">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-punt-longest</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-punt-longest</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of yards gained on the longest punt return.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-punt-touchdown">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-punt-touchdown</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-punt-touchdown</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of punts returned for a touchdown.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-punt-against-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-punt-against-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-punt-against-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of punt returns defended.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-punt-against-yards">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-punt-against-yards</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-punt-against-yards</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of yards allowed from punt returns.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-punt-against-average">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-punt-against-average</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-punt-against-average</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of yards allowed from punt returns.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-punt-against-longest">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-punt-against-longest</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-punt-against-longest</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Yardage of longest punt return allowed.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-punt-against-touchdown">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-punt-against-touchdown</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-punt-against-touchdown</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of touchdowns from punt returns allowed.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/kickoffs-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">kickoffs-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">kickoffs-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of kickoffs to opposition.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/kickoffs-adjusted">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">kickoffs-adjusted</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">kickoffs-adjusted</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of kickoffs excluding onside kicks or kickoffs at the end of a half
                unless either kickoff is returned for a touchdown.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/kickoffs-to-inside-20">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">kickoffs-to-inside-20</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">kickoffs-to-inside-20</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of kickoffs resulting in opponent's possession starting inside own 20
                yard line.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/kickoffs-drive-start-against-average">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">kickoffs-drive-start-against-average</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">kickoffs-drive-start-against-average</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average starting position of opponent's possession after a
                kickoff.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/onside-kicks-attempted">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">onside-kicks-attempted</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">onside-kicks-attempted</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of onside kicks attempted.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/onside-kicks-recovered">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">onside-kicks-recovered</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">onside-kicks-recovered</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of onside kicks recovered by kicking team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-kickoff-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-kickoff-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-kickoff-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of kickoffs returned.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-kickoff-yards">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-kickoff-yards</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-kickoff-yards</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of yards gained from kickoff returns.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-kickoff-average">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-kickoff-average</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-kickoff-average</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The average number of yards gained on each kickoff return.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-kickoff-longest">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-kickoff-longest</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-kickoff-longest</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of yards gained on the longest kickoff return.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-kickoff-touchdown">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-kickoff-touchdown</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-kickoff-touchdown</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of kickoffs returned for a touchdown.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-kickoff-adjusted">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-kickoff-adjusted</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-kickoff-adjusted</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number kickoffs adjusted for onside and end-of-half (non-touchdown)
                kickoffs.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-kickoff-inside-20">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-kickoff-inside-20</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-kickoff-inside-20</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of kickoff returns that failed to advance past the returning team's
                20 yard line.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-kickoff-drive-start-average">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-kickoff-drive-start-average</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-kickoff-drive-start-average</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average start position after kickoff returns.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-kickoff-against-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-kickoff-against-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-kickoff-against-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of kickoff returns.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-kickoff-against-yards">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-kickoff-against-yards</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-kickoff-against-yards</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Yards allowed from kickoff returns.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-kickoff-against-average">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-kickoff-against-average</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-kickoff-against-average</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average yards allowed per kickoff return.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-kickoff-against-longest">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-kickoff-against-longest</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-kickoff-against-longest</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Yardage of longest kickoff return allowed.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-kickoff-against-touchdown">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-kickoff-against-touchdown</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-kickoff-against-touchdown</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Touchdowns allowed from kickoff returns.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The total number of returns. Punts + kickoffs.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/returns-yards">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">returns-yards</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">returns-yards</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The total number of yards gained on punts and kickoffs
                combined.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/punts-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">punts-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">punts-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of punts.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/punts-yards-gross">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">punts-yards-gross</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">punts-yards-gross</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The sum of the distances of all punts.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/punts-yards-net">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">punts-yards-net</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">punts-yards-net</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The sum of the distances of all punts, minus the distances they were
                returned.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/punts-longest">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">punts-longest</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">punts-longest</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The distance of the longest punt.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/punts-inside-20">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">punts-inside-20</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">punts-inside-20</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of punts inside the 20 yard line.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/punts-inside-20-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">punts-inside-20-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">punts-inside-20-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The percentage of punts inside the 20 yard line.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/punts-average">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">punts-average</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">punts-average</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The average gross punting yardage.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/punts-average-net">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">punts-average-net</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">punts-average-net</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average net yards - punt length minus return - per punt.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/punts-against-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">punts-against-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">punts-against-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of punts forced by defensive team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/punts-against-yards-gross">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">punts-against-yards-gross</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">punts-against-yards-gross</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of yards of opposing team's punts.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/punts-against-yards-net">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">punts-against-yards-net</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">punts-against-yards-net</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of net yards - punt length minus return - of opposing team's
                punts.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/punts-against-longest">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">punts-against-longest</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">punts-against-longest</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Longest punt by opposing team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/punts-against-inside-20">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">punts-against-inside-20</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">punts-against-inside-20</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Punt returns failed to advance beyond team's own 20.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/punts-against-inside-20-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">punts-against-inside-20-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">punts-against-inside-20-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Ratio of punt returns failed to advance beyond team's own 20 and total punt
                returns.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/punts-against-average">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">punts-against-average</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">punts-against-average</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average length of opponent's punt.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/punts-against-average-net">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">punts-against-average-net</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">punts-against-average-net</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average net length - punt length minus return - of opponent's
                punt..</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/punts-blocked">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">punts-blocked</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">punts-blocked</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of punts that were blocked.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/punts-against-blocked">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">punts-against-blocked</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">punts-against-blocked</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of punts made by the opposing team that this team or player has
                blocked.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/touchbacks-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">touchbacks-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">touchbacks-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The total number of touchbacks, from kickoffs, punts, interceptions, and
                fumbles.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/touchbacks-total-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">touchbacks-total-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">touchbacks-total-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The percentage of kickoffs, punts, interceptions, and fumbles which resulted
                in a touchback.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/touchbacks-kickoffs">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">touchbacks-kickoffs</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">touchbacks-kickoffs</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of kickoffs that went into the end zone and were not brought
                out.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/touchbacks-kickoffs-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">touchbacks-kickoffs-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">touchbacks-kickoffs-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The percentage of kickoffs resulting in touchbacks.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/touchbacks-punts">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">touchbacks-punts</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">touchbacks-punts</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of punts that went into the end zone and were not brought
                out.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/touchbacks-punts-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">touchbacks-punts-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">touchbacks-punts-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The percentage of punts resulting in touchbacks.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/touchbacks-interceptions">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">touchbacks-interceptions</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">touchbacks-interceptions</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of interceptions that went into the end zone and were not brought
                out.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/touchbacks-interceptions-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">touchbacks-interceptions-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">touchbacks-interceptions-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The percentage of interceptions resulting in touchbacks.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/touchbacks-punts-against">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">touchbacks-punts-against</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">touchbacks-punts-against</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of punts not returned out of receiving team's end zone.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fair-catches">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fair-catches</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fair-catches</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fair catches.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fair-catches-against">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fair-catches-against</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fair-catches-against</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of fair catches by opponents.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/total-return-yardage-not-kickoffs">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">total-return-yardage-not-kickoffs</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">total-return-yardage-not-kickoffs</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Net return yardage excluding kickoff returns.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/touchdowns-against">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">touchdowns-against</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">touchdowns-against</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total number of special teams touchdowns allowed.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/tackles-special-teams">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">tackles-special-teams</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">tackles-special-teams</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of tackles made while playing for a special-team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/tackles-assists-special-teams">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">tackles-assists-special-teams</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">tackles-assists-special-teams</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of tackle assists performed while on special-teams.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/extra-points-against-made">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">extra-points-against-made</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">extra-points-against-made</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of extra point attempts made by the opposing team that were
                successful.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/extra-points-against-missed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">extra-points-against-missed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">extra-points-against-missed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of extra point attempts made by the opposing team that were not
                successful.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/extra-points-against-blocked">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">extra-points-against-blocked</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">extra-points-against-blocked</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of extra point attempts made by the opposing team that were blocked
                by this team or player.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/field-goals-against-made">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">field-goals-against-made</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">field-goals-against-made</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of field goal attempts made by the opposing team that were
                successful.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/field-goals-against-missed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">field-goals-against-missed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">field-goals-against-missed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of field goal attempts made by the opposing team that were not
                successful.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/field-goals-against-blocked">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">field-goals-against-blocked</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">field-goals-against-blocked</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Number of field goal attempts made by the opposing team that were blocked by
                this player or team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-committed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-committed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-committed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The total number of fumbles.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-forced">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-forced</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-forced</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles that were forced by the opposing team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-recovered">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-recovered</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-recovered</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles that were recovered by the fumbling team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-lost">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-lost</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-lost</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles that were not recovered by the fumbling
                team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-lost-average-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-lost-average-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-lost-average-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of fumbles lost per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-yards-gained">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-yards-gained</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-yards-gained</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of yards gained as a result of fumbles.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-own-committed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-own-committed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-own-committed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles committed by this team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-own-recovered">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-own-recovered</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-own-recovered</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles committed by this team that were then also recovered
                by this team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-own-lost">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-own-lost</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-own-lost</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles committed by this team but recovered by the other
                team. A subset of turnovers. Also referred to as a giveaway.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-own-yards-gained">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-own-yards-gained</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-own-yards-gained</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of yards gained as a result of fumbles by this team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-own-touchdowns">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-own-touchdowns</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-own-touchdowns</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of touchdowns earned after a team recovers its own
                fumbles.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-opposing-committed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-opposing-committed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-opposing-committed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles committed by the opposing team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-opposing-recovered">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-opposing-recovered</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-opposing-recovered</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles committed by the opposing but recovered by this team.
                A subset of turnovers. Also referred to a takeaway.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-opposing-recovered-average-per-game">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-opposing-recovered-average-per-game</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-opposing-recovered-average-per-game</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Average number of opposing team's fumbles recovered per game.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-opposing-lost">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-opposing-lost</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-opposing-lost</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles committed by the opposing team that were subsequently
                lost to the opposing team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-opposing-yards-gained">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-opposing-yards-gained</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-opposing-yards-gained</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of yards gained as a result of fumbles by the opposing
                team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-opposing-touchdowns">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-opposing-touchdowns</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-opposing-touchdowns</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of touchdowns scored as a result of fumbles by the opposing
                team..</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-committed-defense">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-committed-defense</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-committed-defense</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles committed by a player or team on defense.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-lost-defense">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-lost-defense</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-lost-defense</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles lost by a player or team on defense.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-forced-defense">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-forced-defense</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-forced-defense</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles forced by a player or team on defense.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-recovered-defense">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-recovered-defense</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-recovered-defense</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles recovered by a player or team on defense.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-recovered-yards-defense">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-recovered-yards-defense</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-recovered-yards-defense</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of yards gained on fumbles recovered by a player or team on
                defense.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-committed-special-teams">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-committed-special-teams</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-committed-special-teams</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles committed by a player or team on
                special-teams.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-lost-special-teams">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-lost-special-teams</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-lost-special-teams</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles lost by a player or team on
                special-teams.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-forced-special-teams">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-forced-special-teams</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-forced-special-teams</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles forced by a player or team on
                special-teams.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-recovered-special-teams">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-recovered-special-teams</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-recovered-special-teams</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles recovered by a player or team on
                special-teams.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-recovered-yards-special-teams">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-recovered-yards-special-teams</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-recovered-yards-special-teams</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of yards gained on fumbles recovered by a player or team on
                special-teams.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-committed-other">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-committed-other</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-committed-other</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles committed by a player or team on neither defense or
                special teams.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-lost-other">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-lost-other</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-lost-other</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles lost by a player or team on neither defense or special
                teams.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-forced-other">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-forced-other</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-forced-other</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles forced by a player or team on neither defense or
                special teams.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-recovered-other">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-recovered-other</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-recovered-other</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles recovered by a player or team on neither defense or
                special teams.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/fumbles-recovered-yards-other">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">fumbles-recovered-yards-other</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">fumbles-recovered-yards-other</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of yards gained on fumbles recovered by a player or team on
                neither defense or special teams.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/touchbacks-fumbles">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">touchbacks-fumbles</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">touchbacks-fumbles</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of fumbles into the end zone that are not brought
                out.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/touchbacks-fumbles-percentage">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">touchbacks-fumbles-percentage</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">touchbacks-fumbles-percentage</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The percentage of fumbles that resulted in touchbacks.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/penalties-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">penalties-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">penalties-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of penalties.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/penalty-yards">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">penalty-yards</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">penalty-yards</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The yards gained as a result of penalties.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/penalty-first-downs">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">penalty-first-downs</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">penalty-first-downs</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of first downs gained as a result of penalties.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/penalty-opponent-yards">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">penalty-opponent-yards</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">penalty-opponent-yards</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Yards opponents gain as a result of penalties.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/penalties-opponent-total">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">penalties-opponent-total</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">penalties-opponent-total</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total of penalties by opposing team.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/penalties-challenged">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">penalties-challenged</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">penalties-challenged</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Includes penalty challenges that were both won and lost.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/penalties-reviewed">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">penalties-reviewed</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">penalties-reviewed</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Includes both coach challenges and booth challenges (by the replay assistant
                in the NFL).</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spamfstat/penalties-overturned">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">penalties-overturned</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">penalties-overturned</skos:prefLabel>
		<skos:definition xml:lang="en-GB">The number of successful penalty challenges by a team, leading to the
                overturning of the original call.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spamfstat/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description></rdf:RDF>