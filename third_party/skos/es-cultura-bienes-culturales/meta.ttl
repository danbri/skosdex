@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# Tesauro de Bienes Culturales (Espana)
# License verified 2026-08-21: Same bespoke open terms.
<#scheme> a skosdex:Scheme ;
    dcterms:title "Tesauro de Bienes Culturales (Espana)" ;
    dcterms:publisher <https://www.cultura.gob.es/> ;
    skosdex:conceptSchemeURI <https://tesauros.cultura.gob.es/tesauros/bienesculturales> ;
    skosdex:sourceURL <https://tesauros.cultura.gob.es/tesauros/descarga/skos-bienes-culturales.zip> ;
    skosdex:sourceFormat "application/rdf+xml" ;
    skosdex:compression "zip" ;
    skosdex:sourceEntry "skos-bienes-culturales.rdf" ;
    dcterms:license <https://tesauros.cultura.gob.es/tesauros/condiciones-de-uso> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle true .
