@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# NASA GCMD Science Keywords
# License verified 2026-08-21: US-gov work; earthdata data-use policy: NASA-led mission data CC0. Exemplar of ~15 GCMD schemes (rest TODO).
<#scheme> a skosdex:Scheme ;
    dcterms:title "NASA GCMD Science Keywords" ;
    dcterms:publisher <https://gcmd.earthdata.nasa.gov/> ;
    skosdex:conceptSchemeURI <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords> ;
    skosdex:sourceURL <https://gcmd.earthdata.nasa.gov/kms/concepts/concept_scheme/sciencekeywords?format=rdf> ;
    skosdex:sourceFormat "application/rdf+xml" ;
    dcterms:license <https://www.usa.gov/government-copyright> ;
    skosdex:licenseClass "public-domain" ;
    skosdex:bundle true .
