@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# NDLSH — National Diet Library Subject Headings (Japan), via Web NDL Authorities.
# ~20,800 skos:Concept, Japanese subject headings (SKOS + SKOS-XL), with reading
# and some English labels. License: NDL terms of use (id.ndl.go.jp/information/
# use_en) — reuse for commercial or non-commercial purposes without application,
# attribution required ("obtained from Web NDL Authorities"). Permissive,
# commercial-OK, no share-alike -> licenseClass "open" (NDL custom, not CC).
# Source: the 5-part RDF/XML bulk dump (ndlsh-rdf.zip), combined to N-Triples.
<#scheme> a skosdex:Scheme ;
    dcterms:title "NDLSH — National Diet Library Subject Headings (Japan)" ;
    dcterms:publisher <https://www.ndl.go.jp/> ;
    skosdex:conceptSchemeURI <http://id.ndl.go.jp/auth/ndlsh> ;
    skosdex:sourceURL <https://id.ndl.go.jp/auth/data/download/ndlsh-rdf.zip> ;
    skosdex:sourceFormat "application/n-triples" ;
    dcterms:license <https://id.ndl.go.jp/information/use_en/> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle true .
