@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# UNESCO Thesaurus, CC BY-SA 3.0 IGO -> copyleft -> CONTAINER-ONLY under
# policy v2 (2026-06-10): bundled with explicit licensing, no semantic changes
# (N-Quads formatting only); excluded from all static artifacts.
<#scheme> a skosdex:Scheme ;
    dcterms:title "UNESCO Thesaurus" ;
    dcterms:publisher <https://www.unesco.org/> ;
    skosdex:conceptSchemeURI <http://vocabularies.unesco.org/thesaurus> ;
    skosdex:sourceURL <https://vocabularies.unesco.org/exports/thesaurus/latest/unesco-thesaurus.ttl> ;
    skosdex:sourceFormat "text/turtle" ;
    dcterms:license <https://creativecommons.org/licenses/by-sa/3.0/igo/> ;
    skosdex:licenseClass "copyleft" ;
    skosdex:bundle true .
