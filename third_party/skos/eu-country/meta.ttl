@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# Countries and territories Named Authority List ("country" authority table)
# from the EU Publications Office (EU Vocabularies). Reuse is governed by
# Commission Decision 2011/833/EU (the data.europa.eu record for dataset
# "country" lists licence COM_REUSE, i.e. that Decision), which the EU legal
# notice implements as CC BY 4.0 (verified 2026-06-10 at
# https://commission.europa.eu/legal-notice_en; dataset record:
# https://data.europa.eu/data/datasets/country) -> open.
#
# Source: the SKOS_CORE distribution (countries-skos.rdf, RDF/XML) via the OP
# euvoc-download-handler, as published in the dataset's download_url.
# The pipeline converts RDF/XML via rapper.
<#scheme> a skosdex:Scheme ;
    dcterms:title "Countries and territories Named Authority List (EU Publications Office)" ;
    dcterms:publisher <https://op.europa.eu/> ;
    skosdex:conceptSchemeURI <http://publications.europa.eu/resource/authority/country> ;
    skosdex:sourceURL <https://op.europa.eu/o/opportal-service/euvoc-download-handler?cellarURI=http%3A%2F%2Fpublications.europa.eu%2Fresource%2Fcellar%2F07ed8d46-2b56-11e7-9412-01aa75ed71a1.0001.10%2FDOC_1&fileName=countries-skos.rdf> ;
    skosdex:sourceFormat "application/rdf+xml" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle true .
