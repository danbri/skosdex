@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# Getty Thesaurus of Geographic Names (TGN). ODC-By 1.0 -> open, bundleable in
# principle. full.zip (~1.9GB) holds three N-Triples members; TGNOut_Full.nt
# is the complete graph. compression "zip" + sourceEntry select it.
# DEFERRED (bundle:false): TGNOut_Full.nt is ~38.8GB uncompressed (verified via
# unzip -l on the 2025-01-19 dump). The pipeline decompresses the full member
# to cache/source.nt before the external sort, so it needs ~80GB transient disk
# (source + sort temp). Far exceeds the current build env (re-checked
# 2026-06-10 during the completion sweep: ~21GB free, shared with sibling
# agents — still insufficient). The record is ready — flip bundle:true and
# `skosdex build getty-tgn` on a box with ~100GB free.
<#scheme> a skosdex:Scheme ;
    dcterms:title "Getty Thesaurus of Geographic Names (TGN)" ;
    dcterms:publisher <https://www.getty.edu/research/> ;
    skosdex:conceptSchemeURI <http://vocab.getty.edu/tgn/> ;
    skosdex:sourceURL <http://tgndownloads.getty.edu/VocabData/full.zip> ;
    skosdex:sourceFormat "application/n-triples" ;
    skosdex:compression "zip" ;
    skosdex:sourceEntry "TGNOut_Full.nt" ;
    dcterms:license <https://opendatacommons.org/licenses/by/1-0/> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle false .
