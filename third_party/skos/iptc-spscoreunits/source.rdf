<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:skos="http://www.w3.org/2004/02/skos/core#" xmlns:owl="http://www.w3.org/2002/07/owl#">
	<rdf:Description rdf:about="http://cv.iptc.org/newscodes/spscoreunits/">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/spscoreunits/time-absolute"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/spscoreunits/time-relative"/>
		<skos:hasTopConcept rdf:resource="http://cv.iptc.org/newscodes/spscoreunits/against-par"/>
	</rdf:Description>
	<rdf:Description rdf:about="http://cv.iptc.org/newscodes/spscoreunits/time-absolute">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">time-absolute</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">time-absolute</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Total time to complete competition, not measured in comparison to other
                competitors</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spscoreunits/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spscoreunits/time-relative">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">time-relative</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">time-relative</skos:prefLabel>
		<skos:definition xml:lang="en-GB">Time difference compared (usually) to closest competitor or first-place
                finalist. First place commonly has absolute value.</skos:definition>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spscoreunits/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description><rdf:Description rdf:about="http://cv.iptc.org/newscodes/spscoreunits/against-par">
		<rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
		<skos:prefLabel xml:lang="en-US">against-par</skos:prefLabel>
		<skos:prefLabel xml:lang="en-GB">against-par</skos:prefLabel>
		<skos:inScheme rdf:resource="http://cv.iptc.org/newscodes/spscoreunits/"/><!--Broader Relationships--><!--Narrower Relationships--><!--SKOS Mapping Relationships--></rdf:Description></rdf:RDF>