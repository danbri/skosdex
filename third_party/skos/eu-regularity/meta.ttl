@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# EU eProcurement / eForms codelist "regularity" — EU Publications Office (EU
# Vocabularies). Reuse under Commission Decision 2011/833/EU, implemented as
# CC BY 4.0 -> open. Source: SKOS-core RDF/XML via the OP euvoc-download-handler;
# converted via rapper. Part of the complete eProcurement authority-table set.
<#scheme> a skosdex:Scheme ;
    dcterms:title "regularity — EU eProcurement codelist (Publications Office)" ;
    dcterms:publisher <https://op.europa.eu/> ;
    skosdex:conceptSchemeURI <http://publications.europa.eu/resource/authority/regularity> ;
    skosdex:sourceURL <https://op.europa.eu/o/opportal-service/euvoc-download-handler?cellarURI=http%3A%2F%2Fpublications.europa.eu%2Fresource%2Fcellar%2F6c87a88b-c33b-11ed-a05c-01aa75ed71a1.0001.03%2FDOC_1&fileName=regularity-skos.rdf> ;
    skosdex:sourceFormat "application/rdf+xml" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle true .
