@prefix skosdex: <https://danbri.org/ns/skosdex#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# AgroPortal SKOS ontology "SHKG". Fetched key-free via the AgroPortal download
# endpoint (enumerated through the public ontologies_filter?format=SKOS, found
# by headless-browser discovery). License https://creativecommons.org/licenses/by/4.0/ -> open if CC BY/CC0.
<#scheme> a skosdex:Scheme ;
    dcterms:title "SHKG (AgroPortal)" ;
    dcterms:publisher <https://agroportal.eu/> ;
    skosdex:conceptSchemeURI <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
    skosdex:sourceURL <https://agroportal.eu/ontologies/SHKG/download> ;
    skosdex:sourceFormat "application/n-triples" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    skosdex:licenseClass "open" ;
    skosdex:bundle true .
