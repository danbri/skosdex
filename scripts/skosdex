#!/usr/bin/env node
// skosdex — read per-scheme meta.ttl, fetch/cache, normalize to N-Quads,
// canonicalize blank nodes (RDFC-1.0), and bundle openly-licensed schemes
// into a single dataset for the SPARQL + Solr container.
//
// Usage:
//   skosdex list                  List schemes and their license / bundle status
//   skosdex fetch    [slug]       Download source(s) into the scheme cache
//   skosdex normalize [slug]      Parse source -> sorted N-Quads (normalized.nq)
//   skosdex canonicalize [slug]   normalized.nq.gz -> canonical.nq.gz (RDFC-1.0)
//   skosdex bundle                Merge open-licensed canonical.nq.gz -> dist/bundle.nq.gz
//   skosdex solr-docs             Derive dist/solr-docs.json from the bundle
//   skosdex build                 fetch + normalize + canonicalize + bundle + solr-docs
//
// Only schemes whose license is open / public-domain (and not opted out) are
// bundled. Copyleft (viral / share-alike), non-commercial and proprietary data
// is never written into the shipped dataset — only its metadata stays in repo.

import fs from 'node:fs';
import path from 'node:path';
import zlib from 'node:zlib';
import { execFileSync } from 'node:child_process';
import readline from 'node:readline';
import { Readable } from 'node:stream';
import { pipeline } from 'node:stream/promises';
import { fileURLToPath } from 'node:url';
import N3 from 'n3';
import rdfCanonize from 'rdf-canonize';

const { Parser, Writer, Store, DataFactory } = N3;
const { namedNode, blankNode, defaultGraph, quad } = DataFactory;

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const ROOT = path.resolve(__dirname, '..');
const SCHEMES_DIR = path.join(ROOT, 'third_party', 'skos');
const DIST_DIR = path.join(ROOT, 'dist');

const NS = {
  rdf: 'http://www.w3.org/1999/02/22-rdf-syntax-ns#',
  dcterms: 'http://purl.org/dc/terms/',
  skos: 'http://www.w3.org/2004/02/skos/core#',
  skosdex: 'https://danbri.org/ns/skosdex#',
};

// License gates (policy v2, 2026-06-10, repo owner's call):
// - OPEN_CLASSES may appear anywhere: container, Pages demo, static artifacts.
// - CONTAINER_CLASSES additionally admits copyleft (CC BY-SA) and
//   noncommercial (CC BY-NC-ND) data into the CONTAINER bundle only — license
//   explicit per scheme in third_party/ meta.ttl + manifest.json, content
//   semantically unchanged (N-Quads syntax normalization only). These never
//   reach the Pages demo / docs/ site or other static redistributions.
// - proprietary/unknown are excluded everywhere. (ODbL not yet granted.)
const OPEN_CLASSES = new Set(['open', 'public-domain']);
const CONTAINER_CLASSES = new Set([...OPEN_CLASSES, 'copyleft', 'noncommercial']);

const EXT_BY_FORMAT = {
  'text/turtle': 'ttl',
  'application/n-triples': 'nt',
  'application/n-quads': 'nq',
  'application/trig': 'trig',
  'text/n3': 'n3',
  'application/rdf+xml': 'rdf',
};

// ---------------------------------------------------------------------------
// Metadata
// ---------------------------------------------------------------------------

function listSlugs() {
  if (!fs.existsSync(SCHEMES_DIR)) return [];
  return fs
    .readdirSync(SCHEMES_DIR, { withFileTypes: true })
    .filter((d) => d.isDirectory())
    .map((d) => d.name)
    .filter((name) => fs.existsSync(path.join(SCHEMES_DIR, name, 'meta.ttl')))
    .sort();
}

function readMeta(slug) {
  const dir = path.join(SCHEMES_DIR, slug);
  const text = fs.readFileSync(path.join(dir, 'meta.ttl'), 'utf8');
  const store = new Store(new Parser().parse(text));

  const subjects = store.getSubjects(namedNode(NS.rdf + 'type'), namedNode(NS.skosdex + 'Scheme'));
  if (subjects.length === 0) throw new Error(`${slug}/meta.ttl: no skosdex:Scheme found`);
  const s = subjects[0];

  const one = (term, pfx, local) => {
    const o = store.getObjects(term, namedNode(NS[pfx] + local))[0];
    return o ? o.value : undefined;
  };

  const meta = {
    slug,
    dir,
    title: one(s, 'dcterms', 'title') || slug,
    conceptSchemeURI: one(s, 'skosdex', 'conceptSchemeURI'),
    sourceURL: one(s, 'skosdex', 'sourceURL'),
    sourceFile: one(s, 'skosdex', 'sourceFile'),
    sourceFormat: one(s, 'skosdex', 'sourceFormat') || 'text/turtle',
    compression: (one(s, 'skosdex', 'compression') || 'none').toLowerCase(),
    sourceEntry: one(s, 'skosdex', 'sourceEntry'),
    license: one(s, 'dcterms', 'license'),
    licenseClass: (one(s, 'skosdex', 'licenseClass') || 'unknown').toLowerCase(),
    bundle: one(s, 'skosdex', 'bundle') !== 'false',
  };
  meta.openData = OPEN_CLASSES.has(meta.licenseClass);
  meta.eligible = CONTAINER_CLASSES.has(meta.licenseClass) && meta.bundle;
  return meta;
}

function bundleReason(meta) {
  if (!CONTAINER_CLASSES.has(meta.licenseClass)) return `excluded (license: ${meta.licenseClass})`;
  if (!meta.bundle) return 'excluded (bundle: false)';
  return meta.openData ? 'included' : `included (container-only: ${meta.licenseClass})`;
}

// ---------------------------------------------------------------------------
// N-Quads helpers
// ---------------------------------------------------------------------------

function writeNQuads(quads) {
  return new Promise((resolve, reject) => {
    const writer = new Writer({ format: 'N-Quads' });
    writer.addQuads(quads);
    writer.end((err, result) => (err ? reject(err) : resolve(result)));
  });
}

function sortDedupeLines(nq) {
  const lines = [...new Set(nq.split('\n').map((l) => l.trim()).filter(Boolean))];
  lines.sort();
  return lines.join('\n') + '\n';
}

function parseQuads(text, format) {
  return new Parser({ format }).parse(text);
}

// All N-Quads artifacts are stored gzipped (`.nq.gz`) and tracked via Git LFS
// (see .gitattributes / CLAUDE.md). N-Quads gzips ~16x, which keeps large
// schemes well under GitHub's per-file limit and cheap to ship. These helpers
// make gzip transparent: write*/read* (de)compress when the path ends in .gz.
function writeText(file, text) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, file.endsWith('.gz') ? zlib.gzipSync(text) : text);
}

function readText(file) {
  const buf = fs.readFileSync(file);
  return (file.endsWith('.gz') ? zlib.gunzipSync(buf) : buf).toString('utf8');
}

// Canonical/normalized/bundle artifact paths — gzipped N-Quads.
const NQ = 'nq.gz';
function schemeArtifact(meta, name) {
  return path.join(meta.dir, `${name}.${NQ}`);
}

// ---------------------------------------------------------------------------
// Pipeline steps
// ---------------------------------------------------------------------------

function sourcePath(meta) {
  if (meta.sourceFile) return path.join(meta.dir, meta.sourceFile);
  const ext = EXT_BY_FORMAT[meta.sourceFormat] || 'ttl';
  return path.join(meta.dir, 'cache', `source.${ext}`);
}

// Decompress a downloaded archive file -> the cache source file, streaming via
// the shell so large members (AGROVOC ~1.45GB) never pass through a JS string
// or an execFileSync stdout buffer. gzip uses `gunzip`, zip uses `unzip -p`,
// both redirected straight to `out`. For zip, sourceEntry picks the member.
function decompressFile(dl, out, meta) {
  if (meta.compression === 'none') {
    fs.renameSync(dl, out);
    return;
  }
  // Node's fetch transparently decodes Content-Encoding: gzip, so a ".gz" URL
  // may already be plain text on disk (MeSH does this). Sniff the magic bytes.
  const head = Buffer.alloc(2);
  const hfd = fs.openSync(dl, 'r'); fs.readSync(hfd, head, 0, 2, 0); fs.closeSync(hfd);
  const isGzip = head[0] === 0x1f && head[1] === 0x8b;
  if (meta.compression === 'gzip' && !isGzip) {
    console.log('  fetch: server pre-decoded gzip; using as-is');
    fs.renameSync(dl, out);
    return;
  }
  const fd = fs.openSync(out, 'w');
  try {
    if (meta.compression === 'gzip') {
      execFileSync('gunzip', ['-c', dl], { stdio: ['ignore', fd, 'inherit'], maxBuffer: Infinity });
    } else if (meta.compression === 'zip') {
      const entry = meta.sourceEntry
        || execFileSync('unzip', ['-Z1', dl], { encoding: 'utf8' }).split('\n').filter(Boolean)[0];
      execFileSync('unzip', ['-p', dl, entry], { stdio: ['ignore', fd, 'inherit'], maxBuffer: Infinity });
    } else {
      throw new Error(`unknown compression: ${meta.compression}`);
    }
  } finally {
    fs.closeSync(fd);
  }
  fs.rmSync(dl);
}

async function fetchScheme(meta) {
  if (meta.sourceFile) {
    console.log(`  fetch    ${meta.slug}: local sourceFile, nothing to download`);
    return;
  }
  if (!meta.sourceURL) {
    console.log(`  fetch    ${meta.slug}: no sourceURL/sourceFile — skipping`);
    return;
  }
  const out = sourcePath(meta);
  fs.mkdirSync(path.dirname(out), { recursive: true });
  const tag = meta.compression === 'none' ? '' : ` (${meta.compression})`;
  console.log(`  fetch    ${meta.slug}: ${meta.sourceURL}${tag}`);
  const res = await fetch(meta.sourceURL, { headers: { Accept: meta.sourceFormat } });
  if (!res.ok) throw new Error(`fetch ${meta.sourceURL} -> HTTP ${res.status}`);
  // Stream the download straight to disk (handles multi-GB without buffering).
  const dl = out + '.download';
  await pipeline(Readable.fromWeb(res.body), fs.createWriteStream(dl));
  decompressFile(dl, out, meta);
}

async function normalizeScheme(meta) {
  let src = sourcePath(meta);
  if (!fs.existsSync(src)) {
    console.log(`  normalize ${meta.slug}: no source at ${path.relative(ROOT, src)} — run fetch first`);
    return;
  }
  // Stream-parse the source (bounded memory, handles multi-GB sources that
  // would overflow a single JS string / the n3 in-memory Store), emit one
  // N-Quad line per quad to a temp file, then sort+dedupe with the OS `sort`
  // (external, disk-backed) and gzip the result.
  const raw = path.join(meta.dir, 'cache', '_normalized.raw');
  fs.mkdirSync(path.dirname(raw), { recursive: true });
  // RDF/XML: n3 can't parse it — convert with `rapper` (raptor2-utils) to
  // N-Triples first, then fall through to the line-based path. This unlocks
  // the many vocabularies published only as RDF/XML (GEMET, GeoNames, ...).
  let format = meta.sourceFormat;
  if (format === 'application/rdf+xml') {
    const converted = path.join(meta.dir, 'cache', '_converted.nt');
    const fd = fs.openSync(converted, 'w');
    try {
      execFileSync('rapper', ['-i', 'rdfxml', '-o', 'ntriples', src],
        { stdio: ['ignore', fd, 'pipe'], maxBuffer: Infinity });
    } finally {
      fs.closeSync(fd);
    }
    src = converted;
    format = 'application/n-triples';
    console.log(`  normalize ${meta.slug}: rapper rdfxml -> ntriples`);
  }
  // N-Triples/N-Quads are line-oriented: parse each line independently so one
  // malformed line (e.g. in Getty's 3.6GB dump) is skipped, not fatal. Other
  // formats (Turtle/TriG) need the whole-document streaming parser.
  const lineBased = format === 'application/n-triples' || format === 'application/n-quads';
  const count = lineBased
    ? await lineNormalizeToNQuads(src, format, raw)
    : await streamParseToNQuads(src, format, raw);
  const sorted = path.join(meta.dir, 'cache', '_normalized.sorted');
  execFileSync('sort', ['-u', '-o', sorted, raw], { stdio: 'inherit', env: { ...process.env, LC_ALL: 'C' } });
  // gzip sorted -> normalized.nq.gz
  const fd = fs.openSync(schemeArtifact(meta, 'normalized'), 'w');
  try {
    execFileSync('gzip', ['-c', sorted], { stdio: ['ignore', fd, 'inherit'], maxBuffer: Infinity });
  } finally {
    fs.closeSync(fd);
  }
  fs.rmSync(raw, { force: true }); fs.rmSync(sorted, { force: true });
  console.log(`  normalize ${meta.slug}: ${count} quads -> normalized.${NQ}`);
}

// Fault-tolerant line-based normalize for N-Triples/N-Quads. Parses each line
// with its own n3 parser so a single malformed line is skipped (counted) rather
// than aborting the whole multi-GB stream. Emits canonical N-Quads lines.
async function lineNormalizeToNQuads(src, format, outFile) {
  const rl = readline.createInterface({ input: fs.createReadStream(src), crlfDelay: Infinity });
  const out = fs.createWriteStream(outFile);
  const writer = new Writer({ format: 'N-Quads' });
  let count = 0, skipped = 0;
  for await (const line of rl) {
    const t = line.trim();
    if (!t || t.startsWith('#')) continue;
    try {
      const quads = new Parser({ format }).parse(t.endsWith('.') ? t : t + ' .');
      for (const q of quads) {
        if (!out.write(writer.quadToString(q.subject, q.predicate, q.object, q.graph))) {
          await new Promise((r) => out.once('drain', r));
        }
        count++;
      }
    } catch {
      skipped++;
    }
  }
  await new Promise((r) => out.end(r));
  if (skipped) console.log(`  normalize: skipped ${skipped} malformed line(s)`);
  return count;
}

// Stream a source RDF file through the n3 parser, writing each quad as an
// N-Quads line to `outFile`. Returns the quad count. Bounded memory.
function streamParseToNQuads(src, format, outFile) {
  return new Promise((resolve, reject) => {
    const parser = new N3.StreamParser({ format });
    const writer = new N3.StreamWriter({ format: 'N-Quads' });
    const out = fs.createWriteStream(outFile);
    let count = 0;
    parser.on('data', () => count++);
    fs.createReadStream(src).pipe(parser).pipe(writer).pipe(out);
    out.on('finish', () => resolve(count));
    parser.on('error', reject);
    writer.on('error', reject);
    out.on('error', reject);
  });
}

async function canonicalizeScheme(meta) {
  const norm = schemeArtifact(meta, 'normalized');
  if (!fs.existsSync(norm)) {
    console.log(`  canon    ${meta.slug}: no normalized.${NQ} — run normalize first`);
    return;
  }
  // RDFC-1.0 only does work when blank nodes are present, and rdf-canonize is
  // in-memory (the input must fit one JS string, <512MB). So:
  //  - no blank nodes  -> the sorted normalized N-Quads IS canonical; copy it.
  //  - blank nodes, but small enough -> run RDFC-1.0.
  //  - blank nodes, but too large (e.g. AGROVOC: 10M quads, 211 bnodes in its
  //    OWL header) -> RDFC-1.0 can't ingest it. The normalized form is sorted &
  //    deduped from a single deterministic upstream dump, so its blank-node
  //    labels are already stable run-to-run; ship it as canonical and warn.
  const canon = schemeArtifact(meta, 'canonical');
  if (!await nqGzHasBlankNodes(norm)) {
    fs.copyFileSync(norm, canon);
    console.log(`  canon    ${meta.slug}: no blank nodes — canonical = normalized`);
    return;
  }
  // Decompressed-size guard: stay well under the ~512MB JS string limit.
  const RDFC_MAX_BYTES = 256 * 1024 * 1024;
  let decompressedBytes = 0;
  await new Promise((resolve, reject) => {
    const gz = fs.createReadStream(norm).pipe(zlib.createGunzip());
    gz.on('data', (c) => { decompressedBytes += c.length; });
    gz.on('end', resolve); gz.on('error', reject);
  });
  if (decompressedBytes > RDFC_MAX_BYTES) {
    fs.copyFileSync(norm, canon);
    console.log(`  canon    ${meta.slug}: ${(decompressedBytes / 1e6).toFixed(0)}MB > RDFC-1.0 limit — using sorted normalized as canonical (stable bnode labels from upstream dump)`);
    return;
  }
  const canonical = await rdfCanonize.canonize(readText(norm), {
    algorithm: 'RDFC-1.0',
    inputFormat: 'application/n-quads',
    format: 'application/n-quads',
  });
  writeText(canon, canonical);
  console.log(`  canon    ${meta.slug}: canonical.${NQ} written (RDFC-1.0)`);
}

// Stream a gzipped N-Quads file and report whether any blank node appears,
// without holding the whole (possibly multi-GB) text in memory.
function nqGzHasBlankNodes(file) {
  return new Promise((resolve, reject) => {
    const rl = readline.createInterface({ input: fs.createReadStream(file).pipe(zlib.createGunzip()) });
    let found = false;
    rl.on('line', (line) => {
      if (!found && /(^|\s)_:/.test(line)) { found = true; rl.close(); }
    });
    rl.on('close', () => resolve(found));
    rl.on('error', reject);
  });
}

// Re-label blank nodes per-scheme and place each scheme in its own named
// graph so multiple schemes merge into one dataset without collisions.
function relabelIntoGraph(quads, slug, graphTerm) {
  const map = (t) => (t.termType === 'BlankNode' ? blankNode(`${slug}-${t.value}`) : t);
  return quads.map((q) => quad(map(q.subject), q.predicate, map(q.object), graphTerm));
}

// Append a scheme's canonical N-Quads into the gzipped raw bundle, placing each
// quad in the scheme's named graph. Done as a shell pipeline (awk) rather than
// Node line-by-line — awk is ~100x faster on 10M+ line schemes (Getty/AGROVOC),
// and the whole thing streams so multi-GB schemes never load into memory:
//   zcat canonical.nq.gz | awk '{ inject graph, prefix blank nodes }' | gzip >> raw.gz
// Concatenated gzip members decompress as one stream, keeping disk small.
// Returns the quad (line) count.
function appendSchemeToBundle(meta, canon, rawOut) {
  const graph = meta.conceptSchemeURI ? ` <${meta.conceptSchemeURI}> ` : ' ';
  // awk: strip trailing " ." , prefix bnode labels with the slug, append graph.
  // Bnode substitution is anchored to where bnodes can occur in canonical
  // N-Quads: subject (line start) and object (immediately after the
  // predicate's "> ") — so literal text containing "_:" is never rewritten.
  const prog =
    `{ sub(/[ \\t]*\\.[ \\t]*$/, "");` +
    ` if (substr($0,1,2) == "_:") sub(/^_:/, "_:${meta.slug}");` +
    ` gsub(/> _:/, "> _:${meta.slug}");` +
    ` print $0 "${graph}." }`;
  execFileSync('bash', ['-c',
    `set -o pipefail; zcat "${canon}" | awk '${prog}' | gzip >> "${rawOut}"`,
  ], { stdio: ['ignore', 'inherit', 'inherit'], maxBuffer: Infinity });
  // Count = number of lines in the canonical (one quad per line).
  const out = execFileSync('bash', ['-c', `zcat "${canon}" | wc -l`], { encoding: 'utf8' });
  return Number(out.trim());
}

// Per-scheme deploy artifacts: dist/graphed/<slug>.nq.gz — each scheme's
// canonical quads with its named graph injected. No cross-scheme merge or
// global sort (schemes occupy disjoint graphs and each canonical is already
// sorted+deduped), so adding one scheme never re-processes the others: the
// container loads these incrementally against per-scheme volume markers.
async function graphedAll() {
  const metas = listSlugs().map(readMeta);
  const manifest = { generated: new Date().toISOString(), included: [], excluded: [] };
  const outDir = path.join(DIST_DIR, 'graphed');
  fs.rmSync(outDir, { recursive: true, force: true });
  fs.mkdirSync(outDir, { recursive: true });

  for (const meta of metas) {
    const reason = bundleReason(meta);
    if (!reason.startsWith('included')) {
      manifest.excluded.push({ slug: meta.slug, licenseClass: meta.licenseClass, reason });
      console.log(`  graphed  ${meta.slug}: ${reason}`);
      continue;
    }
    const canon = schemeArtifact(meta, 'canonical');
    if (!fs.existsSync(canon)) {
      manifest.excluded.push({ slug: meta.slug, reason: `no canonical.${NQ} (run build)` });
      console.log(`  graphed  ${meta.slug}: skipped (no canonical.${NQ})`);
      continue;
    }
    const out = path.join(outDir, `${meta.slug}.${NQ}`);
    const graph = meta.conceptSchemeURI ? ` <${meta.conceptSchemeURI}> ` : ' ';
    const prog =
      `{ sub(/[ \\t]*\\.[ \\t]*$/, "");` +
      ` if (index($0, "_:")) gsub(/_:/, "_:${meta.slug}");` +
      ` print $0 "${graph}." }`;
    execFileSync('bash', ['-c',
      `set -o pipefail; zcat "${canon}" | awk '${prog}' | gzip > "${out}"`,
    ], { stdio: 'inherit', maxBuffer: Infinity });
    const count = Number(execFileSync('bash', ['-c', `zcat "${canon}" | wc -l`], { encoding: 'utf8' }).trim());
    manifest.included.push({
      slug: meta.slug,
      title: meta.title,
      license: meta.license,
      licenseClass: meta.licenseClass,
      containerOnly: !meta.openData,
      modifications: 'N-Quads syntax normalization only; no semantic changes',
      graph: meta.conceptSchemeURI || null,
      quads: count,
    });
    console.log(`  graphed  ${meta.slug}: ${count} quads -> dist/graphed/${meta.slug}.${NQ}`);
  }
  fs.writeFileSync(path.join(DIST_DIR, 'manifest.json'), JSON.stringify(manifest, null, 2) + '\n');
  console.log(`  graphed  -> ${manifest.included.length} schemes`);
}

async function bundleAll() {
  const metas = listSlugs().map(readMeta);
  const manifest = { generated: new Date().toISOString(), included: [], excluded: [] };
  fs.mkdirSync(DIST_DIR, { recursive: true });
  // Gzipped raw accumulator (~300MB vs ~5GB uncompressed) so CI disk holds.
  const raw = path.join(DIST_DIR, '_bundle.raw.gz');
  if (fs.existsSync(raw)) fs.rmSync(raw);

  for (const meta of metas) {
    const reason = bundleReason(meta);
    if (!reason.startsWith('included')) {
      manifest.excluded.push({ slug: meta.slug, licenseClass: meta.licenseClass, reason });
      console.log(`  bundle   ${meta.slug}: ${reason}`);
      continue;
    }
    const canon = schemeArtifact(meta, 'canonical');
    if (!fs.existsSync(canon)) {
      manifest.excluded.push({ slug: meta.slug, reason: `no canonical.${NQ} (run build)` });
      console.log(`  bundle   ${meta.slug}: skipped (no canonical.${NQ})`);
      continue;
    }
    const count = appendSchemeToBundle(meta, canon, raw);
    manifest.included.push({
      slug: meta.slug,
      title: meta.title,
      license: meta.license,
      licenseClass: meta.licenseClass,
      containerOnly: !meta.openData,   // BY-SA / NC-ND: container only, never static artifacts
      modifications: 'N-Quads syntax normalization only; no semantic changes',
      graph: meta.conceptSchemeURI || null,
      quads: count,
    });
    console.log(`  bundle   ${meta.slug}: +${count} quads`);
  }

  // External sort+dedupe streamed end to end so no multi-GB uncompressed file
  // ever lands on disk (CI runners have ~14GB free). The raw is gzipped; we
  // gunzip it, sort with gzip-compressed temp files (--compress-program), and
  // gzip the result — all in one shell pipeline.
  //   gunzip -c raw.gz | LC_ALL=C sort -u -S25% --compress-program=gzip -T dist | gzip > bundle.nq.gz
  const bundleOut = path.join(DIST_DIR, `bundle.${NQ}`);
  execFileSync('bash', ['-c',
    `set -o pipefail; gunzip -c "${raw}" | LC_ALL=C sort -u -S25% --compress-program=gzip -T "${DIST_DIR}" | gzip > "${bundleOut}"`,
  ], { stdio: 'inherit', maxBuffer: Infinity });
  fs.rmSync(raw, { force: true });
  fs.writeFileSync(path.join(DIST_DIR, 'manifest.json'), JSON.stringify(manifest, null, 2) + '\n');
  const total = manifest.included.reduce((a, x) => a + x.quads, 0);
  console.log(`  bundle   -> dist/bundle.${NQ} (${total} quads, ${manifest.included.length} schemes)`);
}

// Flatten the bundle into one Solr doc per skos:Concept. Streams the (sorted)
// gzipped bundle line-by-line: all lines for a subject are contiguous, so we
// accumulate one subject at a time and flush — bounded memory even for AGROVOC.
// Writes a JSON array incrementally so the full doc set never lives in RAM.
async function solrDocs() {
  const graphedDir = path.join(DIST_DIR, 'graphed');
  const bundle = path.join(DIST_DIR, `bundle.${NQ}`);
  const inputs = fs.existsSync(graphedDir)
    ? fs.readdirSync(graphedDir).filter((f) => f.endsWith(`.${NQ}`)).sort().map((f) => path.join(graphedDir, f))
    : (fs.existsSync(bundle) ? [bundle] : []);
  if (!inputs.length) throw new Error('no dist/graphed/*.nq.gz or dist/bundle.nq.gz — run graphed (or bundle) first');

  const FIELD = {
    [NS.skos + 'prefLabel']: 'prefLabel',
    [NS.skos + 'altLabel']: 'altLabel',
    [NS.skos + 'definition']: 'definition',
    [NS.skos + 'broader']: 'broader',
    [NS.skos + 'narrower']: 'narrower',
    // RDF extras for the REST/autocomplete API: cross-scheme mappings + codes.
    [NS.skos + 'exactMatch']: 'exactMatch',
    [NS.skos + 'closeMatch']: 'closeMatch',
    [NS.skos + 'notation']: 'notation',
  };
  const TYPE = NS.rdf + 'type';
  const CONCEPT = NS.skos + 'Concept';
  // Match an N-Quads line: <s> <p> ("lit"... | <o>) [<graph>] .
  const LINE = /^<([^>]+)>\s+<([^>]+)>\s+(?:<([^>]+)>|"((?:[^"\\]|\\.)*)"(?:@([\w-]+)|\^\^<[^>]+>)?)\s*(?:<([^>]+)>\s*)?\.\s*$/;

  fs.mkdirSync(DIST_DIR, { recursive: true });
  // Two outputs: the single solr-docs.json (demo/Pages consume it) and
  // dist/solr-parts/part-NNNN.json batches of PART_DOCS docs each — Solr's
  // default heap can't swallow a single ~180MB POST (it shipped, it died),
  // so the deployment posts the parts one by one.
  const PART_DOCS = 50000;
  const partsDir = path.join(DIST_DIR, 'solr-parts');
  fs.rmSync(partsDir, { recursive: true, force: true });
  fs.mkdirSync(partsDir, { recursive: true });
  const outStream = fs.createWriteStream(path.join(DIST_DIR, 'solr-docs.json'));
  outStream.write('[\n');
  let nDocs = 0, partNo = 0, partCount = 0, partStream = null;
  const openPart = () => {
    partStream = fs.createWriteStream(path.join(partsDir, `part-${String(partNo).padStart(4, '0')}.json`));
    partStream.write('[\n');
    partCount = 0;
  };
  const closePart = () => new Promise((r) => { partStream.write('\n]\n'); partStream.end(r); });
  openPart();
  let cur = null; // { id, scheme, isConcept, fields:{} }
  const flushDoc = async () => {
    if (cur && cur.isConcept) {
      const json = JSON.stringify({ id: cur.id, scheme: cur.scheme, ...(cur.exactLabel ? { exactLabel: cur.exactLabel } : {}), ...cur.fields });
      outStream.write((nDocs++ ? ',\n' : '') + json);
      if (partCount >= PART_DOCS) { await closePart(); partNo++; openPart(); }
      partStream.write((partCount++ ? ',\n' : '') + json);
    }
  };

  for (const input of inputs) {
  const rl = readline.createInterface({ input: fs.createReadStream(input).pipe(zlib.createGunzip()) });
  for await (const line of rl) {
    const m = LINE.exec(line);
    if (!m) continue;
    const [, s, p, oIri, oLit, lang, graph] = m;
    if (!cur || cur.id !== s) { await flushDoc(); cur = { id: s, scheme: graph || null, isConcept: false, exactLabel: null, fields: {} }; }
    if (p === TYPE && oIri === CONCEPT) cur.isConcept = true;
    const field = FIELD[p];
    if (field) (cur.fields[field] ||= []).push(oIri !== undefined ? oIri : oLit);
    // Single English prefLabel -> exactLabel: a low-cardinality field so an
    // entry whose whole label IS the query ranks above ones that merely list
    // it among 40 languages (AGROVOC 'rice' was losing to monolingual LCSH).
    if (p === NS.skos + 'prefLabel' && oLit !== undefined && (lang === 'en' || !lang) && !cur.exactLabel) {
      cur.exactLabel = oLit;
    }
  }
  }
  await flushDoc();
  outStream.write('\n]\n');
  await Promise.all([new Promise((r) => outStream.end(r)), closePart()]);
  console.log(`  solr     -> dist/solr-docs.json (${nDocs} concept docs; ${partNo + 1} parts of <=${PART_DOCS})`);
}

// Bake a single self-contained HTML file with the concept data embedded, so the
// bundle can be browsed/searched in any browser with no server, no Docker, no
// network. This is the "try it now" demo; the real deployment is the Docker
// SPARQL + Solr + web stack.
// Cap concepts embedded in the standalone demo. The full corpus (600k+ docs)
// is far too large for a browser to load from one HTML file; the demo is a
// showcase/sample, and the live SPARQL+Solr endpoints serve everything.
const DEMO_MAX_PER_SCHEME = 2000;

async function buildDemo() {
  const src = path.join(DIST_DIR, 'solr-docs.json');
  if (!fs.existsSync(src)) throw new Error('dist/solr-docs.json missing — run build first');
  // POLICY: the demo is a static redistribution (GitHub Pages), so only
  // open/public-domain schemes may appear. Container-only data (BY-SA, NC-ND)
  // ships solely in the deployed image — never in static artifacts.
  const openGraphs = new Set(
    listSlugs().map(readMeta).filter((m) => m.openData && m.conceptSchemeURI)
      .map((m) => m.conceptSchemeURI),
  );
  // Stream the (possibly huge) JSON array line-by-line — each doc is written on
  // its own line by solrDocs — sampling up to N docs per scheme so the demo
  // stays small regardless of corpus size.
  const perScheme = new Map();
  const data = [];
  const rl = readline.createInterface({ input: fs.createReadStream(src) });
  for await (const raw of rl) {
    const line = raw.replace(/,\s*$/, '').trim();
    if (line === '[' || line === ']' || !line) continue;
    let d;
    try { d = JSON.parse(line); } catch { continue; }
    if (!openGraphs.has(d.scheme)) continue;   // container-only data stays out
    const n = perScheme.get(d.scheme) || 0;
    if (n >= DEMO_MAX_PER_SCHEME) continue;
    perScheme.set(d.scheme, n + 1);
    data.push({ i: d.id, p: d.prefLabel || [], a: d.altLabel || [], d: d.definition || [], b: d.broader || [], n: d.narrower || [], s: d.scheme || null });
  }
  const html = DEMO_HTML.replace('/*__DATA__*/', JSON.stringify(data));
  fs.mkdirSync(DIST_DIR, { recursive: true });
  const out = path.join(DIST_DIR, 'demo.html');
  fs.writeFileSync(out, html);
  console.log(`  demo     -> dist/demo.html (${data.length} concepts sampled from ${perScheme.size} schemes; full corpus via endpoints)`);
}

// Publish the demo + data into docs/ for classic branch-based GitHub Pages
// (Settings -> Pages -> Deploy from a branch -> claude/main -> /docs). No
// Actions deploy job, so nothing to fail. Run after bundle + solr-docs + demo.
function buildSite() {
  const DOCS = path.join(ROOT, 'docs');
  fs.mkdirSync(DOCS, { recursive: true });
  // docs/ is committed and served by GitHub Pages, so it carries ONLY the small
  // sampled demo + the manifest — never the full bundle/solr-docs (hundreds of
  // MB; the live fly.io endpoints serve the complete corpus). manifest.json is
  // tiny and useful as a provenance/license listing.
  fs.copyFileSync(path.join(DIST_DIR, 'demo.html'), path.join(DOCS, 'index.html'));
  const man = path.join(DIST_DIR, 'manifest.json');
  if (fs.existsSync(man)) fs.copyFileSync(man, path.join(DOCS, 'manifest.json'));
  // Drop any oversized data files a previous version may have copied in.
  for (const f of [`bundle.${NQ}`, 'solr-docs.json']) {
    const stale = path.join(DOCS, f);
    if (fs.existsSync(stale)) fs.rmSync(stale);
  }
  fs.writeFileSync(path.join(DOCS, '.nojekyll'), ''); // serve files verbatim
  console.log('  site     -> docs/ (sampled demo + manifest for GitHub Pages)');
}

const DEMO_HTML = `<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>skosdex demo</title>
<style>
 *{box-sizing:border-box} body{font:15px/1.5 system-ui,sans-serif;margin:0;color:#1a1a1a;background:#fafafa}
 header{background:#1f2933;color:#fff;padding:1rem 1.25rem}
 header h1{margin:0;font-size:1.25rem} header p{margin:.25rem 0 0;color:#9aa5b1;font-size:.85rem}
 .wrap{max-width:880px;margin:0 auto;padding:1.25rem}
 #q{width:100%;padding:.6rem .75rem;font-size:1rem;border:1px solid #cbd2d9;border-radius:6px}
 .stat{color:#7b8794;font-size:.82rem;margin:.5rem 0 1rem}
 .hit{background:#fff;border:1px solid #e4e7eb;border-radius:6px;padding:.6rem .8rem;margin-bottom:.5rem}
 .hit h3{margin:0 0 .2rem;font-size:1rem} .hit h3 a{color:#2563eb;text-decoration:none}
 .alt{color:#52606d;font-size:.85rem} .def{margin:.3rem 0 0;font-size:.9rem}
 .rel{margin-top:.35rem;font-size:.8rem;color:#616e7c}
 .rel a{color:#2563eb;text-decoration:none;cursor:pointer} .rel a:hover{text-decoration:underline}
 mark{background:#fde68a;padding:0 1px}
 footer{color:#9aa5b1;font-size:.78rem;text-align:center;padding:1.5rem}
</style></head><body>
<header><h1>skosdex demo</h1><p>Self-contained SKOS browser — data embedded, no server needed.</p></header>
<div class="wrap">
 <input id="q" type="text" placeholder="Search concepts… (e.g. weather, election, football)" autofocus>
 <div class="stat" id="stat"></div>
 <div id="results"></div>
</div>
<footer>Generated by <code>skosdex demo</code>. The full project serves this over SPARQL (Oxigraph) + Solr via Docker.</footer>
<script>
const DATA = /*__DATA__*/;
const byId = new Map(DATA.map(d=>[d.i,d]));
const label = d => (d&&d.p&&d.p[0]) ? d.p[0] : (d? d.i.split(/[#/]/).filter(Boolean).pop() : '');
const esc = s => s.replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
function hi(s,q){ if(!q) return esc(s); const i=s.toLowerCase().indexOf(q.toLowerCase()); if(i<0) return esc(s); return esc(s.slice(0,i))+'<mark>'+esc(s.slice(i,i+q.length))+'</mark>'+esc(s.slice(i+q.length)); }
const qEl=document.getElementById('q'), resEl=document.getElementById('results'), statEl=document.getElementById('stat');

function render(list,q){
 statEl.textContent = list.length+' / '+DATA.length+' concepts'+(q?(' matching "'+q+'"'):'');
 resEl.innerHTML = list.slice(0,200).map(d=>{
  const alt = d.a.length? '<div class="alt">also: '+d.a.map(x=>hi(x,q)).join(', ')+'</div>':'';
  const def = d.d.length? '<div class="def">'+esc(d.d[0])+'</div>':'';
  const rels = [...d.b.map(x=>['↑',x]),...d.n.map(x=>['↓',x])]
    .filter(([_,id])=>byId.has(id))
    .map(([ar,id])=>'<a data-go="'+esc(id)+'">'+ar+' '+esc(label(byId.get(id)))+'</a>').join(' · ');
  return '<div class="hit"><h3><a href="'+esc(d.i)+'" target="_blank" rel="noopener">'+hi(label(d),q)+'</a></h3>'
   +alt+def+(rels?'<div class="rel">'+rels+'</div>':'')+'</div>';
 }).join('') + (list.length>200?'<div class="stat">…showing first 200</div>':'');
}
function search(q){
 q=q.trim();
 if(!q){ render(DATA.slice().sort((a,b)=>label(a).localeCompare(label(b))),''); return; }
 const ql=q.toLowerCase();
 const list=DATA.filter(d=>[...d.p,...d.a,...d.d].some(s=>s.toLowerCase().includes(ql)))
   .sort((a,b)=>label(a).localeCompare(label(b)));
 render(list,q);
}
qEl.addEventListener('input',e=>search(e.target.value));
resEl.addEventListener('click',e=>{ const id=e.target.getAttribute&&e.target.getAttribute('data-go'); if(id){e.preventDefault(); const d=byId.get(id); qEl.value=label(d); search(qEl.value); window.scrollTo(0,0);} });
search('');
</script></body></html>`;

// ---------------------------------------------------------------------------
// CLI
// ---------------------------------------------------------------------------

function selectMetas(slug) {
  const slugs = slug ? [slug] : listSlugs();
  return slugs.map(readMeta);
}

async function main() {
  const [cmd, arg] = process.argv.slice(2);
  switch (cmd) {
    case 'list': {
      const metas = listSlugs().map(readMeta);
      if (metas.length === 0) console.log('No schemes found under third_party/skos/');
      for (const m of metas) {
        console.log(`${m.slug.padEnd(24)} ${m.licenseClass.padEnd(14)} ${bundleReason(m)}`);
      }
      break;
    }
    case 'fetch':
      for (const m of selectMetas(arg).filter((m) => m.eligible || arg)) await fetchScheme(m);
      break;
    case 'normalize':
      for (const m of selectMetas(arg).filter((m) => m.eligible || arg)) await normalizeScheme(m);
      break;
    case 'canonicalize':
      for (const m of selectMetas(arg).filter((m) => m.eligible || arg)) await canonicalizeScheme(m);
      break;
    case 'bundle':
      await bundleAll();
      break;
    case 'graphed':
      await graphedAll();
      break;
    case 'solr-docs':
      await solrDocs();
      break;
    case 'demo':
      await buildDemo();
      break;
    case 'site':
      // Offline: bundle from committed canonical.nq.gz, then publish into docs/.
      await bundleAll();
      await solrDocs();
      await buildDemo();
      buildSite();
      break;
    case 'build': {
      for (const m of selectMetas(arg)) {
        if (!m.eligible) {
          console.log(`  skip     ${m.slug}: ${bundleReason(m)} — metadata only, no data steps`);
          continue;
        }
        await fetchScheme(m);
        await normalizeScheme(m);
        await canonicalizeScheme(m);
      }
      await bundleAll();
      await solrDocs();
      await buildDemo();
      break;
    }
    default:
      console.log(`skosdex — fetch, normalize, canonicalize and bundle SKOS schemes.

Usage:
  skosdex list                 List schemes and their license / bundle status
  skosdex fetch        [slug]  Download source(s) into the scheme cache
  skosdex normalize    [slug]  Parse source -> sorted N-Quads (normalized.nq)
  skosdex canonicalize [slug]  normalized.nq.gz -> canonical.nq.gz (RDFC-1.0)
  skosdex bundle               Merge open-licensed schemes -> dist/bundle.nq
  skosdex solr-docs            Derive dist/solr-docs.json from the bundle
  skosdex demo                 Bake dist/demo.html — a standalone browser of the bundle
  skosdex site                 Bundle + demo, publish into docs/ for GitHub Pages
  skosdex build        [slug]  Run the whole pipeline (default: all schemes)

Omit [slug] to act on every scheme under third_party/skos/.`);
      process.exit(cmd ? 1 : 0);
  }
}

main().catch((err) => {
  console.error('skosdex:', err.message);
  process.exit(1);
});
