#!/usr/bin/env node
// skosdex — read per-scheme meta.ttl, fetch/cache, normalize to N-Quads,
// canonicalize blank nodes (RDFC-1.0), and bundle openly-licensed schemes
// into a single dataset for the SPARQL + Solr container.
//
// Usage:
//   skosdex list                  List schemes and their license / bundle status
//   skosdex fetch    [slug]       Download source(s) into the scheme cache
//   skosdex normalize [slug]      Parse source -> sorted N-Quads (normalized.nq)
//   skosdex canonicalize [slug]   normalized.nq.gz -> canonical.nq.gz (RDFC-1.0)
//   skosdex bundle                Merge open-licensed canonical.nq.gz -> dist/bundle.nq.gz
//   skosdex solr-docs             Derive dist/solr-docs.json from the bundle
//   skosdex build                 fetch + normalize + canonicalize + bundle + solr-docs
//
// Only schemes whose license is open / public-domain (and not opted out) are
// bundled. Copyleft (viral / share-alike), non-commercial and proprietary data
// is never written into the shipped dataset — only its metadata stays in repo.

import fs from 'node:fs';
import path from 'node:path';
import zlib from 'node:zlib';
import { execFileSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import N3 from 'n3';
import rdfCanonize from 'rdf-canonize';

const { Parser, Writer, Store, DataFactory } = N3;
const { namedNode, blankNode, defaultGraph, quad } = DataFactory;

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const ROOT = path.resolve(__dirname, '..');
const SCHEMES_DIR = path.join(ROOT, 'third_party', 'skos');
const DIST_DIR = path.join(ROOT, 'dist');

const NS = {
  rdf: 'http://www.w3.org/1999/02/22-rdf-syntax-ns#',
  dcterms: 'http://purl.org/dc/terms/',
  skos: 'http://www.w3.org/2004/02/skos/core#',
  skosdex: 'https://danbri.org/ns/skosdex#',
};

const OPEN_CLASSES = new Set(['open', 'public-domain']);

const EXT_BY_FORMAT = {
  'text/turtle': 'ttl',
  'application/n-triples': 'nt',
  'application/n-quads': 'nq',
  'application/trig': 'trig',
  'text/n3': 'n3',
};

// ---------------------------------------------------------------------------
// Metadata
// ---------------------------------------------------------------------------

function listSlugs() {
  if (!fs.existsSync(SCHEMES_DIR)) return [];
  return fs
    .readdirSync(SCHEMES_DIR, { withFileTypes: true })
    .filter((d) => d.isDirectory())
    .map((d) => d.name)
    .filter((name) => fs.existsSync(path.join(SCHEMES_DIR, name, 'meta.ttl')))
    .sort();
}

function readMeta(slug) {
  const dir = path.join(SCHEMES_DIR, slug);
  const text = fs.readFileSync(path.join(dir, 'meta.ttl'), 'utf8');
  const store = new Store(new Parser().parse(text));

  const subjects = store.getSubjects(namedNode(NS.rdf + 'type'), namedNode(NS.skosdex + 'Scheme'));
  if (subjects.length === 0) throw new Error(`${slug}/meta.ttl: no skosdex:Scheme found`);
  const s = subjects[0];

  const one = (term, pfx, local) => {
    const o = store.getObjects(term, namedNode(NS[pfx] + local))[0];
    return o ? o.value : undefined;
  };

  const meta = {
    slug,
    dir,
    title: one(s, 'dcterms', 'title') || slug,
    conceptSchemeURI: one(s, 'skosdex', 'conceptSchemeURI'),
    sourceURL: one(s, 'skosdex', 'sourceURL'),
    sourceFile: one(s, 'skosdex', 'sourceFile'),
    sourceFormat: one(s, 'skosdex', 'sourceFormat') || 'text/turtle',
    compression: (one(s, 'skosdex', 'compression') || 'none').toLowerCase(),
    sourceEntry: one(s, 'skosdex', 'sourceEntry'),
    license: one(s, 'dcterms', 'license'),
    licenseClass: (one(s, 'skosdex', 'licenseClass') || 'unknown').toLowerCase(),
    bundle: one(s, 'skosdex', 'bundle') !== 'false',
  };
  meta.eligible = OPEN_CLASSES.has(meta.licenseClass) && meta.bundle;
  return meta;
}

function bundleReason(meta) {
  if (!OPEN_CLASSES.has(meta.licenseClass)) return `excluded (license: ${meta.licenseClass})`;
  if (!meta.bundle) return 'excluded (bundle: false)';
  return 'included';
}

// ---------------------------------------------------------------------------
// N-Quads helpers
// ---------------------------------------------------------------------------

function writeNQuads(quads) {
  return new Promise((resolve, reject) => {
    const writer = new Writer({ format: 'N-Quads' });
    writer.addQuads(quads);
    writer.end((err, result) => (err ? reject(err) : resolve(result)));
  });
}

function sortDedupeLines(nq) {
  const lines = [...new Set(nq.split('\n').map((l) => l.trim()).filter(Boolean))];
  lines.sort();
  return lines.join('\n') + '\n';
}

function parseQuads(text, format) {
  return new Parser({ format }).parse(text);
}

// All N-Quads artifacts are stored gzipped (`.nq.gz`) and tracked via Git LFS
// (see .gitattributes / CLAUDE.md). N-Quads gzips ~16x, which keeps large
// schemes well under GitHub's per-file limit and cheap to ship. These helpers
// make gzip transparent: write*/read* (de)compress when the path ends in .gz.
function writeText(file, text) {
  fs.mkdirSync(path.dirname(file), { recursive: true });
  fs.writeFileSync(file, file.endsWith('.gz') ? zlib.gzipSync(text) : text);
}

function readText(file) {
  const buf = fs.readFileSync(file);
  return (file.endsWith('.gz') ? zlib.gunzipSync(buf) : buf).toString('utf8');
}

// Canonical/normalized/bundle artifact paths — gzipped N-Quads.
const NQ = 'nq.gz';
function schemeArtifact(meta, name) {
  return path.join(meta.dir, `${name}.${NQ}`);
}

// ---------------------------------------------------------------------------
// Pipeline steps
// ---------------------------------------------------------------------------

function sourcePath(meta) {
  if (meta.sourceFile) return path.join(meta.dir, meta.sourceFile);
  const ext = EXT_BY_FORMAT[meta.sourceFormat] || 'ttl';
  return path.join(meta.dir, 'cache', `source.${ext}`);
}

// Decompress a downloaded buffer per meta.compression -> the decoded RDF text.
// gzip uses node's zlib; zip shells out to `unzip` (present on dev machines and
// GitHub runners). For zip, sourceEntry picks the member when there are several.
function decompress(buf, meta) {
  if (meta.compression === 'none') return buf.toString('utf8');
  if (meta.compression === 'gzip') return zlib.gunzipSync(buf).toString('utf8');
  if (meta.compression === 'zip') {
    const tmp = path.join(meta.dir, 'cache', '_dl.zip');
    fs.writeFileSync(tmp, buf);
    const names = execFileSync('unzip', ['-Z1', tmp], { encoding: 'utf8' }).split('\n').filter(Boolean);
    const entry = meta.sourceEntry || names[0];
    const text = execFileSync('unzip', ['-p', tmp, entry], { maxBuffer: 1 << 30 }).toString('utf8');
    fs.rmSync(tmp);
    return text;
  }
  throw new Error(`unknown compression: ${meta.compression}`);
}

async function fetchScheme(meta) {
  if (meta.sourceFile) {
    console.log(`  fetch    ${meta.slug}: local sourceFile, nothing to download`);
    return;
  }
  if (!meta.sourceURL) {
    console.log(`  fetch    ${meta.slug}: no sourceURL/sourceFile — skipping`);
    return;
  }
  const out = sourcePath(meta);
  fs.mkdirSync(path.dirname(out), { recursive: true });
  const tag = meta.compression === 'none' ? '' : ` (${meta.compression})`;
  console.log(`  fetch    ${meta.slug}: ${meta.sourceURL}${tag}`);
  const res = await fetch(meta.sourceURL, { headers: { Accept: meta.sourceFormat } });
  if (!res.ok) throw new Error(`fetch ${meta.sourceURL} -> HTTP ${res.status}`);
  const buf = Buffer.from(await res.arrayBuffer());
  fs.writeFileSync(out, decompress(buf, meta));
}

async function normalizeScheme(meta) {
  const src = sourcePath(meta);
  if (!fs.existsSync(src)) {
    console.log(`  normalize ${meta.slug}: no source at ${path.relative(ROOT, src)} — run fetch first`);
    return;
  }
  const quads = parseQuads(fs.readFileSync(src, 'utf8'), meta.sourceFormat);
  const nq = sortDedupeLines(await writeNQuads(quads));
  writeText(schemeArtifact(meta, 'normalized'), nq);
  console.log(`  normalize ${meta.slug}: ${quads.length} quads -> normalized.${NQ}`);
}

async function canonicalizeScheme(meta) {
  const norm = schemeArtifact(meta, 'normalized');
  if (!fs.existsSync(norm)) {
    console.log(`  canon    ${meta.slug}: no normalized.${NQ} — run normalize first`);
    return;
  }
  const text = readText(norm);
  // RDFC-1.0 only does work when blank nodes are present; its cost is
  // superlinear in blank-node count and pointless when there are none. For the
  // many SKOS schemes that are 100% IRI-based (e.g. NALT, IPTC), the already
  // sorted normalized N-Quads IS the canonical form — skip the expensive pass.
  let canonical;
  if (!/(^|\s)_:/.test(text)) {
    canonical = text;
    console.log(`  canon    ${meta.slug}: no blank nodes — canonical = normalized`);
  } else {
    canonical = await rdfCanonize.canonize(text, {
      algorithm: 'RDFC-1.0',
      inputFormat: 'application/n-quads',
      format: 'application/n-quads',
    });
    console.log(`  canon    ${meta.slug}: canonical.${NQ} written (RDFC-1.0)`);
  }
  writeText(schemeArtifact(meta, 'canonical'), canonical);
}

// Re-label blank nodes per-scheme and place each scheme in its own named
// graph so multiple schemes merge into one dataset without collisions.
function relabelIntoGraph(quads, slug, graphTerm) {
  const map = (t) => (t.termType === 'BlankNode' ? blankNode(`${slug}-${t.value}`) : t);
  return quads.map((q) => quad(map(q.subject), q.predicate, map(q.object), graphTerm));
}

async function bundleAll() {
  const metas = listSlugs().map(readMeta);
  const all = [];
  const manifest = { generated: new Date().toISOString(), included: [], excluded: [] };

  for (const meta of metas) {
    const reason = bundleReason(meta);
    if (reason !== 'included') {
      manifest.excluded.push({ slug: meta.slug, licenseClass: meta.licenseClass, reason });
      console.log(`  bundle   ${meta.slug}: ${reason}`);
      continue;
    }
    const canon = schemeArtifact(meta, 'canonical');
    if (!fs.existsSync(canon)) {
      manifest.excluded.push({ slug: meta.slug, reason: `no canonical.${NQ} (run build)` });
      console.log(`  bundle   ${meta.slug}: skipped (no canonical.${NQ})`);
      continue;
    }
    const graphTerm = meta.conceptSchemeURI ? namedNode(meta.conceptSchemeURI) : defaultGraph();
    const quads = relabelIntoGraph(parseQuads(readText(canon), 'N-Quads'), meta.slug, graphTerm);
    // NB: not all.push(...quads) — spreading a million-element array as call
    // args overflows the stack on large schemes (e.g. NALT, 1.15M quads).
    for (const q of quads) all.push(q);
    manifest.included.push({
      slug: meta.slug,
      title: meta.title,
      license: meta.license,
      licenseClass: meta.licenseClass,
      graph: meta.conceptSchemeURI || null,
      quads: quads.length,
    });
    console.log(`  bundle   ${meta.slug}: +${quads.length} quads`);
  }

  fs.mkdirSync(DIST_DIR, { recursive: true });
  writeText(path.join(DIST_DIR, `bundle.${NQ}`), sortDedupeLines(await writeNQuads(all)));
  fs.writeFileSync(path.join(DIST_DIR, 'manifest.json'), JSON.stringify(manifest, null, 2) + '\n');
  console.log(`  bundle   -> dist/bundle.${NQ} (${all.length} quads, ${manifest.included.length} schemes)`);
}

// Flatten the bundle into one Solr doc per skos:Concept.
function solrDocs() {
  const bundle = path.join(DIST_DIR, `bundle.${NQ}`);
  if (!fs.existsSync(bundle)) throw new Error(`dist/bundle.${NQ} missing — run bundle first`);
  const quads = parseQuads(readText(bundle), 'N-Quads');

  const FIELD = {
    [NS.skos + 'prefLabel']: 'prefLabel',
    [NS.skos + 'altLabel']: 'altLabel',
    [NS.skos + 'definition']: 'definition',
    [NS.skos + 'broader']: 'broader',
    [NS.skos + 'narrower']: 'narrower',
  };
  const TYPE = NS.rdf + 'type';
  const CONCEPT = NS.skos + 'Concept';

  const docs = new Map();
  const isConcept = new Set();
  for (const q of quads) {
    if (q.predicate.value === TYPE && q.object.value === CONCEPT) isConcept.add(q.subject.value);
  }
  for (const q of quads) {
    const id = q.subject.value;
    if (!isConcept.has(id)) continue;
    const doc = docs.get(id) || { id, scheme: q.graph.value || null };
    const field = FIELD[q.predicate.value];
    if (field) (doc[field] ||= []).push(q.object.value);
    docs.set(id, doc);
  }

  const out = [...docs.values()];
  fs.mkdirSync(DIST_DIR, { recursive: true });
  fs.writeFileSync(path.join(DIST_DIR, 'solr-docs.json'), JSON.stringify(out, null, 2) + '\n');
  console.log(`  solr     -> dist/solr-docs.json (${out.length} concept docs)`);
}

// Bake a single self-contained HTML file with the concept data embedded, so the
// bundle can be browsed/searched in any browser with no server, no Docker, no
// network. This is the "try it now" demo; the real deployment is the Docker
// SPARQL + Solr + web stack.
function buildDemo() {
  const src = path.join(DIST_DIR, 'solr-docs.json');
  if (!fs.existsSync(src)) throw new Error('dist/solr-docs.json missing — run build first');
  const docs = JSON.parse(fs.readFileSync(src, 'utf8'));
  // Slim each doc to just the fields the UI uses, with short keys.
  const data = docs.map((d) => ({
    i: d.id,
    p: d.prefLabel || [],
    a: d.altLabel || [],
    d: d.definition || [],
    b: d.broader || [],
    n: d.narrower || [],
    s: d.scheme || null,
  }));
  const html = DEMO_HTML.replace('/*__DATA__*/', JSON.stringify(data));
  fs.mkdirSync(DIST_DIR, { recursive: true });
  const out = path.join(DIST_DIR, 'demo.html');
  fs.writeFileSync(out, html);
  console.log(`  demo     -> dist/demo.html (${data.length} concepts embedded; open in any browser)`);
}

// Publish the demo + data into docs/ for classic branch-based GitHub Pages
// (Settings -> Pages -> Deploy from a branch -> claude/main -> /docs). No
// Actions deploy job, so nothing to fail. Run after bundle + solr-docs + demo.
function buildSite() {
  const DOCS = path.join(ROOT, 'docs');
  fs.mkdirSync(DOCS, { recursive: true });
  fs.copyFileSync(path.join(DIST_DIR, 'demo.html'), path.join(DOCS, 'index.html'));
  // docs/ is served by GitHub Pages as plain files (NOT via LFS — Pages serves
  // LFS pointers, not content). These are the small committed-bundle artifacts.
  for (const f of [`bundle.${NQ}`, 'solr-docs.json', 'manifest.json']) {
    const src = path.join(DIST_DIR, f);
    if (fs.existsSync(src)) fs.copyFileSync(src, path.join(DOCS, f));
  }
  fs.writeFileSync(path.join(DOCS, '.nojekyll'), ''); // serve files verbatim
  console.log('  site     -> docs/ (index.html + data; commit docs/ for GitHub Pages)');
}

const DEMO_HTML = `<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>skosdex demo</title>
<style>
 *{box-sizing:border-box} body{font:15px/1.5 system-ui,sans-serif;margin:0;color:#1a1a1a;background:#fafafa}
 header{background:#1f2933;color:#fff;padding:1rem 1.25rem}
 header h1{margin:0;font-size:1.25rem} header p{margin:.25rem 0 0;color:#9aa5b1;font-size:.85rem}
 .wrap{max-width:880px;margin:0 auto;padding:1.25rem}
 #q{width:100%;padding:.6rem .75rem;font-size:1rem;border:1px solid #cbd2d9;border-radius:6px}
 .stat{color:#7b8794;font-size:.82rem;margin:.5rem 0 1rem}
 .hit{background:#fff;border:1px solid #e4e7eb;border-radius:6px;padding:.6rem .8rem;margin-bottom:.5rem}
 .hit h3{margin:0 0 .2rem;font-size:1rem} .hit h3 a{color:#2563eb;text-decoration:none}
 .alt{color:#52606d;font-size:.85rem} .def{margin:.3rem 0 0;font-size:.9rem}
 .rel{margin-top:.35rem;font-size:.8rem;color:#616e7c}
 .rel a{color:#2563eb;text-decoration:none;cursor:pointer} .rel a:hover{text-decoration:underline}
 mark{background:#fde68a;padding:0 1px}
 footer{color:#9aa5b1;font-size:.78rem;text-align:center;padding:1.5rem}
</style></head><body>
<header><h1>skosdex demo</h1><p>Self-contained SKOS browser — data embedded, no server needed.</p></header>
<div class="wrap">
 <input id="q" type="text" placeholder="Search concepts… (e.g. weather, election, football)" autofocus>
 <div class="stat" id="stat"></div>
 <div id="results"></div>
</div>
<footer>Generated by <code>skosdex demo</code>. The full project serves this over SPARQL (Oxigraph) + Solr via Docker.</footer>
<script>
const DATA = /*__DATA__*/;
const byId = new Map(DATA.map(d=>[d.i,d]));
const label = d => (d&&d.p&&d.p[0]) ? d.p[0] : (d? d.i.split(/[#/]/).filter(Boolean).pop() : '');
const esc = s => s.replace(/[&<>]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
function hi(s,q){ if(!q) return esc(s); const i=s.toLowerCase().indexOf(q.toLowerCase()); if(i<0) return esc(s); return esc(s.slice(0,i))+'<mark>'+esc(s.slice(i,i+q.length))+'</mark>'+esc(s.slice(i+q.length)); }
const qEl=document.getElementById('q'), resEl=document.getElementById('results'), statEl=document.getElementById('stat');

function render(list,q){
 statEl.textContent = list.length+' / '+DATA.length+' concepts'+(q?(' matching "'+q+'"'):'');
 resEl.innerHTML = list.slice(0,200).map(d=>{
  const alt = d.a.length? '<div class="alt">also: '+d.a.map(x=>hi(x,q)).join(', ')+'</div>':'';
  const def = d.d.length? '<div class="def">'+esc(d.d[0])+'</div>':'';
  const rels = [...d.b.map(x=>['↑',x]),...d.n.map(x=>['↓',x])]
    .filter(([_,id])=>byId.has(id))
    .map(([ar,id])=>'<a data-go="'+esc(id)+'">'+ar+' '+esc(label(byId.get(id)))+'</a>').join(' · ');
  return '<div class="hit"><h3><a href="'+esc(d.i)+'" target="_blank" rel="noopener">'+hi(label(d),q)+'</a></h3>'
   +alt+def+(rels?'<div class="rel">'+rels+'</div>':'')+'</div>';
 }).join('') + (list.length>200?'<div class="stat">…showing first 200</div>':'');
}
function search(q){
 q=q.trim();
 if(!q){ render(DATA.slice().sort((a,b)=>label(a).localeCompare(label(b))),''); return; }
 const ql=q.toLowerCase();
 const list=DATA.filter(d=>[...d.p,...d.a,...d.d].some(s=>s.toLowerCase().includes(ql)))
   .sort((a,b)=>label(a).localeCompare(label(b)));
 render(list,q);
}
qEl.addEventListener('input',e=>search(e.target.value));
resEl.addEventListener('click',e=>{ const id=e.target.getAttribute&&e.target.getAttribute('data-go'); if(id){e.preventDefault(); const d=byId.get(id); qEl.value=label(d); search(qEl.value); window.scrollTo(0,0);} });
search('');
</script></body></html>`;

// ---------------------------------------------------------------------------
// CLI
// ---------------------------------------------------------------------------

function selectMetas(slug) {
  const slugs = slug ? [slug] : listSlugs();
  return slugs.map(readMeta);
}

async function main() {
  const [cmd, arg] = process.argv.slice(2);
  switch (cmd) {
    case 'list': {
      const metas = listSlugs().map(readMeta);
      if (metas.length === 0) console.log('No schemes found under third_party/skos/');
      for (const m of metas) {
        console.log(`${m.slug.padEnd(24)} ${m.licenseClass.padEnd(14)} ${bundleReason(m)}`);
      }
      break;
    }
    case 'fetch':
      for (const m of selectMetas(arg).filter((m) => m.eligible || arg)) await fetchScheme(m);
      break;
    case 'normalize':
      for (const m of selectMetas(arg).filter((m) => m.eligible || arg)) await normalizeScheme(m);
      break;
    case 'canonicalize':
      for (const m of selectMetas(arg).filter((m) => m.eligible || arg)) await canonicalizeScheme(m);
      break;
    case 'bundle':
      await bundleAll();
      break;
    case 'solr-docs':
      solrDocs();
      break;
    case 'demo':
      buildDemo();
      break;
    case 'site':
      // Offline: bundle from committed canonical.nq.gz, then publish into docs/.
      await bundleAll();
      solrDocs();
      buildDemo();
      buildSite();
      break;
    case 'build': {
      for (const m of selectMetas(arg)) {
        if (!m.eligible) {
          console.log(`  skip     ${m.slug}: ${bundleReason(m)} — metadata only, no data steps`);
          continue;
        }
        await fetchScheme(m);
        await normalizeScheme(m);
        await canonicalizeScheme(m);
      }
      await bundleAll();
      solrDocs();
      buildDemo();
      break;
    }
    default:
      console.log(`skosdex — fetch, normalize, canonicalize and bundle SKOS schemes.

Usage:
  skosdex list                 List schemes and their license / bundle status
  skosdex fetch        [slug]  Download source(s) into the scheme cache
  skosdex normalize    [slug]  Parse source -> sorted N-Quads (normalized.nq)
  skosdex canonicalize [slug]  normalized.nq.gz -> canonical.nq.gz (RDFC-1.0)
  skosdex bundle               Merge open-licensed schemes -> dist/bundle.nq
  skosdex solr-docs            Derive dist/solr-docs.json from the bundle
  skosdex demo                 Bake dist/demo.html — a standalone browser of the bundle
  skosdex site                 Bundle + demo, publish into docs/ for GitHub Pages
  skosdex build        [slug]  Run the whole pipeline (default: all schemes)

Omit [slug] to act on every scheme under third_party/skos/.`);
      process.exit(cmd ? 1 : 0);
  }
}

main().catch((err) => {
  console.error('skosdex:', err.message);
  process.exit(1);
});
