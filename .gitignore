node_modules/
dist/
_site/

# Cached upstream scheme data. Never commit third-party data with a viral
# (copyleft / share-alike) or anti-commercial (NC) license. See
# third_party/skos/README.md for the policy.
third_party/skos/*/cache/
# Top-level scratch for raw upstream downloads (e.g. before a per-scheme
# preparer writes the committed sourceFile). Re-fetchable; never committed.
/cache/

# N-Quads artifacts are stored gzipped (*.nq.gz) via Git LFS — see
# .gitattributes. Canonical files are committed (LFS); intermediate
# normalized.nq.gz is a build artifact, not committed.
third_party/skos/*/normalized.nq.gz

# Never commit uncompressed .nq — everything is gzipped (CLAUDE.md policy).
*.nq

# Local Solr / SPARQL store volumes
.volumes/
*.log

# docs/ is the GitHub Pages site — only the sampled demo + manifest belong.
# Guard against accidentally committing the full bundle/solr-docs (hundreds of
# MB) if a `site`/build run is interrupted mid-copy.
docs/bundle.nq.gz
docs/solr-docs.json

# Subagent worktrees (ephemeral)
.claude/worktrees/

# Generated standalone demo (4MB+ of embedded JSON) — regenerate with
# `node scripts/skosdex demo`; the live endpoint serves the real corpus.
docs/index.html
tools/__pycache__/

# Parliament thesaurus typed source is ~35MB and regenerable (see scheme meta.ttl);
# canonical.nq.gz (LFS) is the committed artifact.
third_party/skos/uk-parliament-thesaurus/source/parliament-lda-terms.typed.ttl
