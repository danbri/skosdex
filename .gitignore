node_modules/
dist/
_site/

# Cached upstream scheme data. Never commit third-party data with a viral
# (copyleft / share-alike) or anti-commercial (NC) license. See
# third_party/skos/README.md for the policy.
third_party/skos/*/cache/

# Large generated artifacts for big schemes — regenerated by `skosdex build`,
# too big to commit (GitHub's limit is 100MB). Small open schemes (e.g.
# example-colors, iptc-media-topics) DO commit their .nq so the demo/CI work
# offline. See third_party/skos/README.md.
third_party/skos/nalt/normalized.nq
third_party/skos/nalt/canonical.nq
third_party/skos/agrovoc/normalized.nq
third_party/skos/agrovoc/canonical.nq
third_party/skos/getty-aat/normalized.nq
third_party/skos/getty-aat/canonical.nq
third_party/skos/lcsh/normalized.nq
third_party/skos/lcsh/canonical.nq

# Local Solr / SPARQL store volumes
.volumes/
*.log
